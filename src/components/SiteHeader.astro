---
// src/components/SiteHeader.astro
//
// Thanh điều hướng dùng chung cho cả bốn trang. Trang chủ cần nav neo trong trang
// và nút đăng ký; ba trang nội dung (điều khoản, bảo mật, lỗi 404) chỉ cần lối về
// trang chủ. Phần khung sticky và logo được tách ra đây thay vì chép lại ở từng trang.
//
// Trang chủ còn có menu di động: dưới breakpoint md, nav neo trong trang thu vào
// một nút mở/đóng để phụ huynh dùng điện thoại vẫn tới được mọi mục.
import { ArrowLeft, ArrowRight, Menu, Phone, X } from "lucide-react";
import { BRAND_INFO } from "../data/courses";

interface Props {
  /** "home": nav neo trong trang + CTA đăng ký. "document": link về trang chủ. */
  variant?: "home" | "document";
}

const { variant = "home" } = Astro.props;
const isHome = variant === "home";

const NAV_LINKS = [
  { href: "#curriculum", label: "Lộ trình" },
  { href: "#branches", label: "Hệ thống trung tâm" },
  { href: "#pricing", label: "Đăng ký & học phí" },
];

const MENU_ID = "gc-mobile-menu";
const TOGGLE_ID = "gc-mobile-menu-toggle";

// Nav neo: mục đang xem được đánh dấu bằng data-active để người dùng biết mình
// đang ở đâu trên trang, thay vì mọi liên kết trông giống hệt nhau.
const NAV_LINK_CLASS =
  "whitespace-nowrap transition-colors hover:text-slate-900 active:text-amber-700 data-[active=true]:text-slate-900 data-[active=true]:underline data-[active=true]:decoration-amber-500 data-[active=true]:decoration-2 data-[active=true]:underline-offset-[6px]";

const hotline = BRAND_INFO.hotlines[0];
const hotlineHref = `tel:${hotline.replace(/\./g, "")}`;
---

<header class="sticky top-0 z-40 bg-cream/95 backdrop-blur-md border-b border-slate-200/80">
  <div
    class:list={[
      "mx-auto px-4 h-16 flex items-center justify-between",
      // Trang chủ chỉ cần gap nhỏ: justify-between đã tách logo, nav và CTA,
      // nhưng vẫn phải giữ khoảng thở khi logo và nút menu gặp nhau ở màn hẹp.
      isHome ? "max-w-6xl gap-3" : "max-w-3xl gap-4",
    ]}
  >
    <a
      href={isHome ? "#main" : "/"}
      class:list={["font-extrabold flex items-center gap-2.5", isHome && "text-lg tracking-tight"]}
    >
      <img
        src="/brand/mark-128.png"
        alt=""
        width="40"
        height="40"
        decoding="async"
        class="w-10 h-10 shrink-0"
      />
      {
        isHome ? (
          <div>
            <div class="leading-none">{BRAND_INFO.name}</div>
            <div class="text-xs font-semibold text-amber-700 mt-0.5 font-sans">
              {BRAND_INFO.slogan1}
            </div>
          </div>
        ) : (
          <span>{BRAND_INFO.name}</span>
        )
      }
    </a>

    {
      isHome ? (
        <>
          <nav
            class="hidden md:flex items-center gap-5 lg:gap-8 text-sm font-semibold text-slate-600"
            aria-label="Điều hướng chính"
          >
            {NAV_LINKS.map((link) => (
              <a href={link.href} data-nav-link class={NAV_LINK_CLASS}>
                {link.label}
              </a>
            ))}
          </nav>

          <div class="flex items-center gap-2">
            {/*
              Dưới sm, CTA nhường chỗ cho nút menu để logo không bị bóp lại. Lối
              đăng ký khi đó vẫn còn: nằm ngay trong menu và ở thanh liên hệ dưới đáy.
            */}
            <a
              href="#pricing"
              class="gc-move gc-move--amber hidden min-h-11 text-xs sm:inline-flex md:text-sm"
            >
              <span class="gc-move__label whitespace-nowrap">Đăng ký tư vấn</span>
              {/*
                Ô đích chỉ hiện từ lg: trong khoảng 768–1023px thanh header đã có
                logo, ba mục nav và nút này, thêm 44px nữa là logo và nav bị ép
                xuống dòng.
              */}
              <span class="gc-move__go hidden lg:inline-flex" aria-hidden="true">
                <ArrowRight className="w-3.5 h-3.5" />
              </span>
            </a>

            <button
              type="button"
              id={TOGGLE_ID}
              aria-expanded="false"
              aria-controls={MENU_ID}
              aria-label="Mở menu điều hướng"
              class="md:hidden inline-flex h-11 w-11 items-center justify-center rounded-control border border-slate-300/90 bg-white/70 text-slate-700 hover:bg-white hover:text-slate-900 active:scale-95 transition"
            >
              <Menu data-menu-icon="open" className="w-5 h-5" aria-hidden="true" />
              <X data-menu-icon="close" className="hidden w-5 h-5" aria-hidden="true" />
            </button>
          </div>
        </>
      ) : (
        <a
          href="/"
          class="inline-flex items-center gap-1.5 text-sm font-semibold text-slate-600 hover:text-slate-900 active:scale-[0.98] transition rounded-control px-2 py-1.5"
        >
          <ArrowLeft className="w-3.5 h-3.5" aria-hidden="true" /> Về trang chủ
        </a>
      )
    }
  </div>

  {isHome && (
    <div
      id={MENU_ID}
      hidden
      class="md:hidden border-t border-slate-200/80 bg-cream/98 backdrop-blur-md"
    >
      <nav class="mx-auto max-w-6xl px-4 py-3" aria-label="Điều hướng di động">
        <ul class="list-none flex flex-col">
          {NAV_LINKS.map((link) => (
            <li>
              <a
                href={link.href}
                data-nav-link
                class="flex min-h-[3rem] items-center justify-between gap-3 border-b border-slate-200/70 text-base font-semibold text-slate-700 transition-colors hover:text-slate-900 active:text-amber-700 data-[active=true]:text-amber-700"
              >
                <span>{link.label}</span>
                <ArrowRight className="w-4 h-4 text-slate-400 shrink-0" aria-hidden="true" />
              </a>
            </li>
          ))}
        </ul>

        <a
          href="#pricing"
          class="gc-move gc-move--amber gc-move--block mt-3"
        >
          <span class="gc-move__label">Đăng ký tư vấn</span>
          <span class="gc-move__go" aria-hidden="true">
            <ArrowRight className="w-4 h-4" />
          </span>
        </a>

        <a
          href={hotlineHref}
          class="mt-2 mb-1 flex min-h-[2.75rem] items-center justify-center gap-2 rounded-control text-sm font-semibold text-slate-600 transition hover:text-slate-900 tabular-nums"
        >
          <Phone className="w-4 h-4 text-slate-500" aria-hidden="true" /> Hotline {hotline}
        </a>
      </nav>
    </div>
  )}
</header>

<script>
  // Menu di động: mở/đóng, đóng khi bấm Esc, bấm ra ngoài hoặc chọn một mục.
  function initMobileMenu() {
    const toggle = document.getElementById("gc-mobile-menu-toggle");
    const panel = document.getElementById("gc-mobile-menu");
    if (!toggle || !panel) return;

    const header = toggle.closest("header");
    const openIcon = toggle.querySelector('[data-menu-icon="open"]');
    const closeIcon = toggle.querySelector('[data-menu-icon="close"]');

    function isOpen() {
      return toggle!.getAttribute("aria-expanded") === "true";
    }

    function setOpen(open: boolean) {
      toggle!.setAttribute("aria-expanded", String(open));
      toggle!.setAttribute("aria-label", open ? "Đóng menu điều hướng" : "Mở menu điều hướng");
      panel!.hidden = !open;
      openIcon?.classList.toggle("hidden", open);
      closeIcon?.classList.toggle("hidden", !open);
    }

    toggle.addEventListener("click", () => setOpen(!isOpen()));

    // Chọn một mục là điều hướng xong: thu menu lại để thấy ngay nội dung.
    panel.addEventListener("click", (event) => {
      if (event.target instanceof Element && event.target.closest("a[href]")) setOpen(false);
    });

    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape" || !isOpen()) return;
      setOpen(false);
      toggle.focus();
    });

    document.addEventListener("click", (event) => {
      if (!isOpen() || !header) return;
      const target = event.target;
      if (target instanceof Node && !header.contains(target)) setOpen(false);
    });

    // Panel tự ẩn ở breakpoint md, nhưng trạng thái aria phải khớp lại.
    window.matchMedia("(min-width: 768px)").addEventListener("change", (event) => {
      if (event.matches) setOpen(false);
    });
  }

  // Đánh dấu mục đang xem trong nav neo, để người dùng biết mình đang ở đâu.
  function initActiveSection() {
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>("a[data-nav-link]"));
    if (links.length === 0 || !("IntersectionObserver" in window)) return;

    const pairs = links
      .map((link) => {
        const id = link.getAttribute("href")?.replace("#", "");
        const section = id ? document.getElementById(id) : null;
        return section ? { link, section } : null;
      })
      .filter((pair): pair is { link: HTMLAnchorElement; section: HTMLElement } => pair !== null);
    if (pairs.length === 0) return;

    const visible = new Set<HTMLElement>();

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const section = entry.target as HTMLElement;
          if (entry.isIntersecting) visible.add(section);
          else visible.delete(section);
        }

        // Nhiều mục có thể cùng nằm trong dải quan sát: chọn mục cao nhất.
        const active = Array.from(visible).sort(
          (a, b) => a.getBoundingClientRect().top - b.getBoundingClientRect().top
        )[0];

        for (const pair of pairs) {
          const on = pair.section === active;
          if (on) {
            pair.link.dataset.active = "true";
            pair.link.setAttribute("aria-current", "true");
          } else {
            delete pair.link.dataset.active;
            pair.link.removeAttribute("aria-current");
          }
        }
      },
      // Dải quan sát nằm dưới thanh header 4rem một chút.
      { rootMargin: "-88px 0px -55% 0px" }
    );

    for (const pair of pairs) observer.observe(pair.section);
  }

  initMobileMenu();
  initActiveSection();
</script>
