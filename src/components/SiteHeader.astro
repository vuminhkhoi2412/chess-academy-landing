---
// src/components/SiteHeader.astro
//
// Đầu trang dùng chung cho mọi trang: thanh trên (hotline, Facebook, bản đồ, nút học thử)
// và thanh menu có mục thả xuống. Mọi liên kết là đường dẫn tuyệt đối ("/#pricing") nên bấm
// từ trang con vẫn về đúng mục của trang chủ.
//
// Mục thả xuống: rê chuột là mở; bàn phím và cảm ứng dùng nút mũi tên cạnh mục cha
// (aria-expanded), Esc đóng. Mục cha vẫn là liên kết thật nên không có JS vẫn đi được.
// Dưới md menu thu vào nút hamburger, các mục con xếp thẳng dưới mục cha.
import { ArrowRight, ChevronDown, Menu, Phone, X, MapPin } from "lucide-react";
import { BRAND_INFO, BRANCHES } from "../data/courses";

interface Props {
  /** Trang chủ truyền false khi quản trị đã đóng form đăng ký: nhãn đổi sang "Học phí". */
  enrolmentOpen?: boolean;
  /** Có ít nhất một bài đã đăng thì menu có thêm "Tin tức". */
  hasNews?: boolean;
}

const { enrolmentOpen = true, hasNews = false } = Astro.props;

// Trang /courses, /branches, /trial chưa có (đợt 5): tạm trỏ tới các mục của trang chủ.
const NAV: { label: string; href: string; children?: { label: string; href: string }[] }[] = [
  {
    label: "Khoá học",
    href: "/#curriculum",
    children: [
      { label: "Lộ trình học", href: "/#curriculum" },
      { label: enrolmentOpen ? "Học phí & đăng ký" : "Học phí", href: "/#pricing" },
    ],
  },
  {
    label: "Cơ sở",
    href: "/#branches",
    children: BRANCHES.map((branch) => ({ label: branch.name, href: "/#branches" })),
  },
  ...(hasNews ? [{ label: "Tin tức", href: "/news" }] : []),
];

const MENU_ID = "gc-mobile-menu";
const TOGGLE_ID = "gc-mobile-menu-toggle";

const hotlineHref = (phone: string) => `tel:${phone.replace(/\./g, "")}`;
const ctaLabel = enrolmentOpen ? "Đăng ký học thử" : "Xem học phí";
const LINK = "transition-colors hover:text-slate-900 active:text-amber-700";
---

<div class="hidden bg-brand-800 text-xs text-brand-100 md:block">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4">
    <p class="flex items-center gap-1.5">
      <Phone className="h-3.5 w-3.5 text-amber-400" aria-hidden="true" />
      <span>Hotline:</span>
      {
        BRAND_INFO.hotlines.map((phone, i) => (
          <>
            {i > 0 && <span aria-hidden="true">–</span>}
            <a href={hotlineHref(phone)} class="inline-flex min-h-9 items-center font-bold tabular-nums text-white hover:underline">
              {phone}
            </a>
          </>
        ))
      }
    </p>
    <div class="flex items-center gap-4">
      <a
        href={BRAND_INFO.facebookPage}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex h-9 w-9 items-center justify-center hover:text-white"
        aria-label="Facebook Global Chess (mở tab mới)"
      >
        <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true"><path d="M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.05V9.41c0-3.02 1.79-4.7 4.53-4.7 1.31 0 2.69.24 2.69.24v2.97h-1.51c-1.49 0-1.96.93-1.96 1.89v2.26h3.33l-.53 3.49h-2.8V24C19.61 23.1 24 18.1 24 12.07z"/></svg>
      </a>
      <a href="/#branches" aria-label="Bản đồ cơ sở" class="inline-flex h-9 w-9 items-center justify-center hover:text-white">
        <MapPin className="h-4 w-4" aria-hidden="true" />
      </a>
      <a
        href="/#pricing"
        class="inline-flex min-h-7 items-center rounded-md bg-amber-400 px-3.5 font-bold text-slate-950 transition hover:bg-amber-300 active:scale-[0.98]"
      >
        {ctaLabel}
      </a>
    </div>
  </div>
</div>

<header class="sticky top-0 z-40 border-b border-slate-200/80 bg-cream/95 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-3 px-4">
    <a href="/" class="flex items-center gap-2.5 text-lg font-extrabold tracking-tight">
      <img src="/brand/mark-128.png" alt="" width="40" height="40" decoding="async" class="h-10 w-10 shrink-0" />
      <div>
        <div class="leading-none">{BRAND_INFO.name}</div>
        <div class="mt-0.5 font-sans text-xs font-semibold text-amber-700">{BRAND_INFO.slogan1}</div>
      </div>
    </a>

    <nav class="hidden items-center gap-6 text-sm font-semibold text-slate-600 md:flex lg:gap-8" aria-label="Điều hướng chính">
      {
        NAV.map((item) => (
          <div class="relative" data-dropdown={item.children ? "" : undefined}>
            <div class="flex items-center">
              <a href={item.href} class={`inline-flex min-h-11 items-center whitespace-nowrap ${LINK}`}>
                {item.label}
              </a>
              {item.children && (
                <button
                  type="button"
                  data-dropdown-toggle
                  aria-expanded="false"
                  aria-label={`Mở các mục của ${item.label}`}
                  class="inline-flex h-11 w-8 items-center justify-center text-slate-500 hover:text-slate-900"
                >
                  <ChevronDown className="h-4 w-4 transition-transform" aria-hidden="true" />
                </button>
              )}
            </div>
            {item.children && (
              <div hidden data-dropdown-panel class="absolute left-0 top-full z-50 w-72 pt-1">
                <ul class="list-none rounded-card border border-slate-200 bg-white p-1.5 shadow-soft">
                  {item.children.map((child) => (
                    <li>
                      <a
                        href={child.href}
                        class="flex min-h-11 items-center rounded-control px-3 text-sm font-semibold text-slate-700 hover:bg-brand-50 hover:text-slate-900"
                      >
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      {/* Nút học thử đã có ở thanh trên (từ md); dưới md nó nằm trong menu và thanh liên hệ dưới đáy. */}
      <button
        type="button"
        id={TOGGLE_ID}
        aria-expanded="false"
        aria-controls={MENU_ID}
        aria-label="Mở menu điều hướng"
        class="inline-flex h-11 w-11 items-center justify-center rounded-control border border-slate-300/90 bg-white/70 text-slate-700 transition hover:bg-white hover:text-slate-900 active:scale-95 md:hidden"
      >
        <Menu data-menu-icon="open" className="h-5 w-5" aria-hidden="true" />
        <X data-menu-icon="close" className="hidden h-5 w-5" aria-hidden="true" />
      </button>
    </div>
  </div>

  <div id={MENU_ID} hidden class="border-t border-slate-200/80 bg-cream md:hidden">
    <nav class="mx-auto max-w-6xl px-4 py-3" aria-label="Điều hướng di động">
      <ul class="flex list-none flex-col">
        {
          NAV.map((item) => (
            <li class="border-b border-slate-200/70">
              <a
                href={item.href}
                class={`flex min-h-12 items-center justify-between gap-3 text-base font-semibold text-slate-800 ${LINK}`}
              >
                <span>{item.label}</span>
                <ArrowRight className="h-4 w-4 shrink-0 text-slate-400" aria-hidden="true" />
              </a>
              {item.children && (
                <ul class="mb-2 list-none border-l-2 border-amber-500/60 pl-3">
                  {item.children.map((child) => (
                    <li>
                      <a href={child.href} class={`flex min-h-11 items-center text-sm font-medium text-slate-600 ${LINK}`}>
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>

      <a href="/#pricing" class="gc-move gc-move--amber gc-move--block mt-3">
        <span class="gc-move__label">{ctaLabel}</span>
        <span class="gc-move__go" aria-hidden="true"><ArrowRight className="h-4 w-4" /></span>
      </a>

      <div class="mt-2 flex flex-wrap items-center justify-center gap-x-5 text-sm font-semibold text-slate-600">
        <a href={hotlineHref(BRAND_INFO.hotlines[0])} class={`inline-flex min-h-11 items-center gap-2 tabular-nums ${LINK}`}>
          <Phone className="h-4 w-4 text-slate-500" aria-hidden="true" /> Hotline {BRAND_INFO.hotlines[0]}
        </a>
        <a href={BRAND_INFO.facebookPage} target="_blank" rel="noopener noreferrer" class={`inline-flex min-h-11 items-center gap-2 ${LINK}`}>
          <svg viewBox="0 0 24 24" class="h-4 w-4 text-slate-500" fill="currentColor" aria-hidden="true"><path d="M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.05V9.41c0-3.02 1.79-4.7 4.53-4.7 1.31 0 2.69.24 2.69.24v2.97h-1.51c-1.49 0-1.96.93-1.96 1.89v2.26h3.33l-.53 3.49h-2.8V24C19.61 23.1 24 18.1 24 12.07z"/></svg> Facebook
          <span class="sr-only">(mở tab mới)</span>
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  // Menu di động: mở/đóng, đóng khi bấm Esc, bấm ra ngoài hoặc chọn một mục.
  function initMobileMenu() {
    const toggle = document.getElementById("gc-mobile-menu-toggle");
    const panel = document.getElementById("gc-mobile-menu");
    if (!toggle || !panel) return;

    const header = toggle.closest("header");
    const openIcon = toggle.querySelector('[data-menu-icon="open"]');
    const closeIcon = toggle.querySelector('[data-menu-icon="close"]');

    const isOpen = () => toggle.getAttribute("aria-expanded") === "true";

    function setOpen(open: boolean) {
      toggle!.setAttribute("aria-expanded", String(open));
      toggle!.setAttribute("aria-label", open ? "Đóng menu điều hướng" : "Mở menu điều hướng");
      panel!.hidden = !open;
      openIcon?.classList.toggle("hidden", open);
      closeIcon?.classList.toggle("hidden", !open);
    }

    toggle.addEventListener("click", () => setOpen(!isOpen()));

    // Chọn một mục là điều hướng xong: thu menu lại để thấy ngay nội dung.
    panel.addEventListener("click", (event) => {
      if (event.target instanceof Element && event.target.closest("a[href]")) setOpen(false);
    });

    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape" || !isOpen()) return;
      setOpen(false);
      toggle.focus();
    });

    document.addEventListener("click", (event) => {
      if (!isOpen() || !header) return;
      if (event.target instanceof Node && !header.contains(event.target)) setOpen(false);
    });

    // Panel tự ẩn ở breakpoint md, nhưng trạng thái aria phải khớp lại.
    window.matchMedia("(min-width: 768px)").addEventListener("change", (event) => {
      if (event.matches) setOpen(false);
    });
  }

  // Mục thả xuống trên desktop: rê chuột mở/đóng; nút mũi tên cho bàn phím và cảm ứng.
  function initDropdowns() {
    const items = Array.from(document.querySelectorAll<HTMLElement>("[data-dropdown]"));
    const canHover = window.matchMedia("(hover: hover)").matches;

    function setOpen(item: HTMLElement, open: boolean) {
      const toggle = item.querySelector<HTMLButtonElement>("[data-dropdown-toggle]");
      const panel = item.querySelector<HTMLElement>("[data-dropdown-panel]");
      if (!toggle || !panel) return;
      toggle.setAttribute("aria-expanded", String(open));
      panel.hidden = !open;
      toggle.querySelector("svg")?.classList.toggle("rotate-180", open);
    }
    const isOpen = (item: HTMLElement) =>
      item.querySelector("[data-dropdown-toggle]")?.getAttribute("aria-expanded") === "true";
    const closeAll = (except?: HTMLElement) => {
      for (const item of items) if (item !== except) setOpen(item, false);
    };

    for (const item of items) {
      item.querySelector("[data-dropdown-toggle]")?.addEventListener("click", () => {
        const open = !isOpen(item);
        closeAll(item);
        setOpen(item, open);
      });

      if (canHover) {
        item.addEventListener("mouseenter", () => {
          closeAll(item);
          setOpen(item, true);
        });
        item.addEventListener("mouseleave", () => setOpen(item, false));
      }

      // Tab ra khỏi mục thì đóng.
      item.addEventListener("focusout", (event) => {
        if (!(event.relatedTarget instanceof Node) || !item.contains(event.relatedTarget)) setOpen(item, false);
      });

      item.addEventListener("keydown", (event) => {
        if (event.key !== "Escape" || !isOpen(item)) return;
        setOpen(item, false);
        item.querySelector<HTMLElement>("[data-dropdown-toggle]")?.focus();
      });
    }

    document.addEventListener("click", (event) => {
      if (!(event.target instanceof Node)) return;
      for (const item of items) if (!item.contains(event.target)) setOpen(item, false);
    });
  }

  initMobileMenu();
  initDropdowns();
</script>
