---
// src/components/admin/RichEditor.astro
//
// Trình soạn bài cho nhân viên: thanh nút có nhãn chữ (không biểu tượng khó hiểu), thấy ngay kết quả,
// không cần biết markdown hay HTML. Giá trị được ghi vào một ô ẩn `name` của form; server lọc lại toàn bộ
// bằng src/server/rich-text.ts nên trình duyệt không phải là nơi bảo đảm an toàn.
import { EDITOR_PALETTE } from "../../data/editor-palette";

interface Props {
  name: string;
  /** HTML ban đầu (đã lọc ở server). */
  html: string;
}
const { name, html } = Astro.props;
const tool = "gc-tool min-h-11 min-w-11 border-2 border-slate-300 bg-white px-3 font-bold text-slate-800 hover:bg-slate-50 aria-pressed:border-brand-800 aria-pressed:bg-brand-800 aria-pressed:text-white";
---

<div class="gc-editor" data-editor>
  <textarea name={name} hidden data-editor-input>{html}</textarea>

  <div role="toolbar" aria-label="Định dạng chữ" class="flex flex-wrap items-center gap-2 border-2 border-b-0 border-slate-300 bg-slate-100 p-2">
    <button type="button" data-cmd="bold" class={tool} aria-label="Chữ đậm" aria-pressed="false"><strong>Đậm</strong></button>
    <button type="button" data-cmd="italic" class={tool} aria-label="Chữ nghiêng" aria-pressed="false"><em>Nghiêng</em></button>
    <button type="button" data-cmd="underline" class={tool} aria-label="Gạch chân" aria-pressed="false"><u>Gạch chân</u></button>
    <span class="mx-1 h-7 w-px bg-slate-300" aria-hidden="true"></span>
    <button type="button" data-cmd="heading" class={tool} aria-label="Tiêu đề mục" aria-pressed="false">Tiêu đề mục</button>
    <button type="button" data-cmd="bullets" class={tool} aria-label="Danh sách chấm" aria-pressed="false">• Danh sách</button>
    <button type="button" data-cmd="numbers" class={tool} aria-label="Danh sách đánh số" aria-pressed="false">1. Danh sách</button>
    <span class="mx-1 h-7 w-px bg-slate-300" aria-hidden="true"></span>
    <button type="button" data-cmd="link" class={tool} aria-label="Chèn liên kết" aria-pressed="false">Liên kết</button>
    <button type="button" data-cmd="color" class={tool} aria-label="Màu chữ" aria-expanded="false" aria-controls="gc-color-panel">
      Màu chữ <span data-color-chip class="ml-1 inline-block size-4 border border-slate-400 align-middle" style="background:#0f172a"></span>
    </button>
    <span class="mx-1 h-7 w-px bg-slate-300" aria-hidden="true"></span>
    <button type="button" data-cmd="undo" class={tool} aria-label="Hoàn tác">↶ Hoàn tác</button>
    <button type="button" data-cmd="redo" class={tool} aria-label="Làm lại">↷ Làm lại</button>
  </div>

  <div id="gc-color-panel" hidden class="border-2 border-b-0 border-slate-300 bg-white p-3">
    <p class="font-semibold">Chọn màu chữ cho phần đang bôi đen</p>
    <ul class="mt-2 flex flex-wrap gap-2">
      {EDITOR_PALETTE.map((color) => (
        <li>
          <button type="button" data-color={color.value} class="flex min-h-11 items-center gap-2 border-2 border-slate-300 bg-white px-3 font-semibold hover:bg-slate-50">
            <span class="inline-block size-5 border border-slate-400" style={`background:${color.value}`}></span>{color.name}
          </button>
        </li>
      ))}
    </ul>
    <div class="mt-3 flex flex-wrap items-center gap-3">
      <label class="flex items-center gap-2 font-semibold">Màu khác
        <input type="color" data-color-free value="#0f172a" class="h-11 w-16 cursor-pointer border-2 border-slate-300 bg-white p-0.5" />
      </label>
      <button type="button" data-color-apply-free class="min-h-11 border-2 border-brand-800 px-4 font-bold text-brand-800 hover:bg-brand-50">Dùng màu này</button>
      <button type="button" data-color-clear class="min-h-11 border-2 border-slate-400 px-4 font-bold hover:bg-slate-50">Bỏ màu (về màu mặc định)</button>
    </div>
  </div>

  <div id="gc-link-panel" hidden class="border-2 border-b-0 border-slate-300 bg-white p-3">
    <label class="flex flex-col gap-1.5">
      <span class="font-semibold">Địa chỉ liên kết cho phần đang bôi đen</span>
      <input type="text" data-link-url inputmode="url" autocomplete="off" placeholder="https://..." class="min-h-11 w-full border-2 border-slate-300 px-3 text-base focus:border-brand-600 focus:outline-none" />
    </label>
    <p data-link-error role="alert" class="mt-1 hidden font-semibold text-seal-red"></p>
    <div class="mt-3 flex flex-wrap gap-3">
      <button type="button" data-link-apply class="min-h-11 border-2 border-brand-800 bg-brand-800 px-4 font-bold text-white">Gắn liên kết</button>
      <button type="button" data-link-remove class="min-h-11 border-2 border-slate-400 px-4 font-bold hover:bg-slate-50">Gỡ liên kết</button>
    </div>
  </div>

  <div data-editor-surface class="gc-prose gc-editor__surface min-h-[22rem] border-2 border-slate-300 bg-white p-4 focus-within:border-brand-600"></div>
  <noscript><p class="mt-2 font-semibold text-seal-red">Trình soạn bài cần bật JavaScript.</p></noscript>
</div>

<style is:global>
  .gc-editor__surface .ProseMirror { min-height: 20rem; outline: none; }
  .gc-editor__surface .ProseMirror p.is-empty:first-child::before {
    content: attr(data-placeholder);
    float: left; height: 0; pointer-events: none; color: var(--color-slate-400);
  }
</style>

<script>
  import { Editor } from "@tiptap/core";
  import StarterKit from "@tiptap/starter-kit";
  import { Color, TextStyle } from "@tiptap/extension-text-style";

  const root = document.querySelector<HTMLElement>("[data-editor]");
  const input = root?.querySelector<HTMLTextAreaElement>("[data-editor-input]");
  const surface = root?.querySelector<HTMLElement>("[data-editor-surface]");

  if (root && input && surface) {
    const colorPanel = root.querySelector<HTMLElement>("#gc-color-panel")!;
    const linkPanel = root.querySelector<HTMLElement>("#gc-link-panel")!;
    const colorChip = root.querySelector<HTMLElement>("[data-color-chip]")!;
    const freeColor = root.querySelector<HTMLInputElement>("[data-color-free]")!;
    const linkUrl = root.querySelector<HTMLInputElement>("[data-link-url]")!;
    const linkError = root.querySelector<HTMLElement>("[data-link-error]")!;

    const editor = new Editor({
      element: surface,
      content: input.value,
      extensions: [
        // Chỉ bật đúng những gì trang cho phép; phần còn lại tắt để dán từ Word/web không mang theo định dạng lạ.
        StarterKit.configure({
          heading: { levels: [2] },
          blockquote: false,
          code: false,
          codeBlock: false,
          horizontalRule: false,
          strike: false,
          link: { openOnClick: false, autolink: false, protocols: ["mailto", "tel"] },
        }),
        TextStyle,
        Color,
      ],
      editorProps: { attributes: { "aria-label": "Nội dung bài viết", role: "textbox", "aria-multiline": "true" } },
      onUpdate: ({ editor }) => sync(editor),
      onSelectionUpdate: ({ editor }) => refresh(editor),
      onTransaction: ({ editor }) => refresh(editor),
    });

    // Nội dung rỗng thì ghi chuỗi rỗng, để server coi là chưa có nội dung.
    function sync(ed: Editor) {
      input!.value = ed.isEmpty ? "" : ed.getHTML();
    }
    sync(editor);

    const cmd = (name: string) => root!.querySelector<HTMLButtonElement>(`[data-cmd="${name}"]`)!;
    function refresh(ed: Editor) {
      const on: Record<string, boolean> = {
        bold: ed.isActive("bold"),
        italic: ed.isActive("italic"),
        underline: ed.isActive("underline"),
        heading: ed.isActive("heading", { level: 2 }),
        bullets: ed.isActive("bulletList"),
        numbers: ed.isActive("orderedList"),
        link: ed.isActive("link"),
      };
      for (const [name, pressed] of Object.entries(on)) cmd(name).setAttribute("aria-pressed", String(pressed));
      colorChip.style.background = ed.getAttributes("textStyle").color || "#0f172a";
    }

    const closePanels = () => {
      colorPanel.hidden = true;
      linkPanel.hidden = true;
      cmd("color").setAttribute("aria-expanded", "false");
    };
    // Khi vùng soạn đang giữ con trỏ (bấm nút không làm mất con trỏ) thì chạy lệnh ngay, không chờ khung hình kế;
    // chỉ khi con trỏ đang ở ô liên kết/màu mới cần trả con trỏ về vùng soạn.
    const chain = () => (editor.isFocused ? editor.chain() : editor.chain().focus());

    const actions: Record<string, () => void> = {
      bold: () => chain().toggleBold().run(),
      italic: () => chain().toggleItalic().run(),
      underline: () => chain().toggleUnderline().run(),
      heading: () => chain().toggleHeading({ level: 2 }).run(),
      bullets: () => chain().toggleBulletList().run(),
      numbers: () => chain().toggleOrderedList().run(),
      undo: () => chain().undo().run(),
      redo: () => chain().redo().run(),
      color: () => {
        const open = colorPanel.hidden;
        closePanels();
        colorPanel.hidden = !open;
        cmd("color").setAttribute("aria-expanded", String(open));
      },
      link: () => {
        const open = linkPanel.hidden;
        closePanels();
        linkPanel.hidden = !open;
        if (open) {
          linkError.classList.add("hidden");
          linkUrl.value = editor.getAttributes("link").href ?? "";
          linkUrl.focus();
        }
      },
    };
    // Bấm nút không được lấy con trỏ khỏi vùng soạn: giữ nguyên vùng đang bôi đen và gõ tiếp được ngay.
    root.addEventListener("mousedown", (event) => {
      if ((event.target as HTMLElement).closest("button")) event.preventDefault();
    });
    root.querySelectorAll<HTMLButtonElement>("[data-cmd]").forEach((button) => {
      button.addEventListener("click", () => actions[button.dataset.cmd!]?.());
    });

    // Màu chữ: bảng sáu màu, màu tự do, và bỏ màu.
    const setColor = (value: string) => { chain().setColor(value).run(); closePanels(); };
    root.querySelectorAll<HTMLButtonElement>("[data-color]").forEach((button) => {
      button.addEventListener("click", () => setColor(button.dataset.color!));
    });
    root.querySelector("[data-color-apply-free]")!.addEventListener("click", () => setColor(freeColor.value));
    root.querySelector("[data-color-clear]")!.addEventListener("click", () => { chain().unsetColor().run(); closePanels(); });

    // Liên kết: thêm https:// nếu thiếu, chỉ nhận http(s), mailto, tel.
    function normalise(raw: string): string | null {
      const text = raw.trim();
      if (text === "") return null;
      const withScheme = /^(https?:|mailto:|tel:)/i.test(text) ? text : /^[a-z][a-z0-9+.-]*:/i.test(text) ? "" : `https://${text}`;
      if (withScheme === "") return null;
      try {
        return new URL(withScheme).href;
      } catch {
        return null;
      }
    }
    root.querySelector("[data-link-apply]")!.addEventListener("click", () => {
      const href = normalise(linkUrl.value);
      if (!href) {
        linkError.textContent = "Địa chỉ chưa đúng. Ví dụ: https://globalchess.edu.vn";
        linkError.classList.remove("hidden");
        return;
      }
      chain().extendMarkRange("link").setLink({ href }).run();
      closePanels();
    });
    root.querySelector("[data-link-remove]")!.addEventListener("click", () => {
      chain().extendMarkRange("link").unsetLink().run();
      closePanels();
    });
    linkUrl.addEventListener("keydown", (event) => {
      if (event.key === "Enter") { event.preventDefault(); root.querySelector<HTMLButtonElement>("[data-link-apply]")!.click(); }
    });

    // Trước khi gửi form (mọi nút đều lưu chữ), chắc chắn ô ẩn khớp với nội dung đang soạn.
    root.closest("form")?.addEventListener("submit", () => sync(editor));
    refresh(editor);
  }
</script>
