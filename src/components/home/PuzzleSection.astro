---
// src/components/home/PuzzleSection.astro
// Bàn cờ đố tương tác, từng nằm ở hero. Chỉ từ md (768px) trở lên, như trước.
import InteractivePuzzle from "../InteractivePuzzle";
---

<section id="co-do" class="hidden border-t border-slate-200 bg-cream py-14 md:block">
  <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 lg:grid-cols-12">
    <div class="lg:col-span-5">
      <h2 class="gc-section-title text-3xl font-extrabold md:text-4xl">Thử một thế cờ</h2>
      <p class="mt-3 max-w-prose text-base leading-relaxed text-slate-600">
        Một thế cờ nhỏ để bạn và bé cùng thử. Kéo quân để đi, bấm "Chơi lại" để xem lại từ đầu.
      </p>
    </div>
    <div class="lg:col-span-7 lg:justify-self-end lg:w-full lg:max-w-md">
      <InteractivePuzzle client:media="(min-width: 768px)" />
    </div>
  </div>
</section>
