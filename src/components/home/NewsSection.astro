---
// src/components/home/NewsSection.astro
// Khối "Tin tức & Góc học tập": thanh tab theo mục, bên dưới là một bài lớn bên trái và ba bài nhỏ bên phải,
// cùng rìa với banner (max-w-6xl, px-4). Mỗi tab là một liên kết thật tới /news?category=...; có JavaScript thì bấm tab
// chỉ đổi nhóm bài ngay tại trang chủ, không có thì đi tới trang danh sách của mục đó. Chỉ dựng khi có bài đã đăng.
import { ArrowRight } from "lucide-react";
import { BRAND_INFO } from "../../data/courses";
import type { Post, PostImage } from "../../server/posts";
import CategoryIcon from "../news/CategoryIcon.astro";
import NewsLead from "../news/NewsLead.astro";
import NewsSideItem from "../news/NewsSideItem.astro";
import { TAB_CLASS } from "../news/ui";

interface Props {
  /** Nhóm đầu là "Tất cả" (slug null), các nhóm sau là từng mục đã có bài. */
  panels: { slug: string | null; name: string; items: { post: Post; cover: PostImage | null }[] }[];
}
const { panels } = Astro.props;
const href = (slug: string | null) => (slug ? `/news?category=${slug}` : "/news");
const showTabs = panels.length > 2; // "Tất cả" + từ hai mục trở lên
---

<section id="news" class="border-t border-slate-200 bg-white pb-6 pt-14" data-news>
  <div class="mx-auto max-w-6xl px-4">
    <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-1">
      <div>
        <h2 class="gc-section-title text-3xl font-extrabold md:text-4xl">Tin tức &amp; Góc học tập</h2>
        <p class="mt-3 max-w-2xl text-slate-600">Cập nhật kiến thức, hoạt động, giải đấu và những câu chuyện truyền cảm hứng từ {BRAND_INFO.name}.</p>
      </div>
      <a href="/news" data-news-all class="inline-flex min-h-11 items-center gap-1.5 text-sm font-bold text-brand-800 hover:underline">
        Xem tất cả <ArrowRight className="h-3.5 w-3.5" aria-hidden="true" />
      </a>
    </div>

    {showTabs && (
      <nav class="mt-6 flex gap-2.5 overflow-x-auto pb-2" aria-label="Xem tin theo mục">
        {panels.map((panel, index) => (
          <a href={href(panel.slug)} data-news-tab={panel.slug ?? ""} aria-current={index === 0 ? "true" : undefined} class={TAB_CLASS}>
            <CategoryIcon slug={panel.slug} /> {panel.name}
          </a>
        ))}
      </nav>
    )}

    {panels.map((panel, index) => {
      const [lead, ...rest] = panel.items;
      return (
        <div data-news-panel={panel.slug ?? ""} hidden={index !== 0} class="mt-6 grid gap-6 lg:grid-cols-12 lg:items-center">
          <div class="lg:col-span-7"><NewsLead post={lead.post} cover={lead.cover} /></div>

          {rest.length > 0 && (
            <ul class="grid list-none content-start divide-y divide-slate-200 lg:col-span-5">
              {rest.map(({ post, cover }) => (
                <li class="py-4 first:pt-0 last:pb-0">
                  <NewsSideItem post={post} cover={cover} />
                </li>
              ))}
            </ul>
          )}
        </div>
      );
    })}
  </div>
</section>

<script is:inline>
  // Bấm tab: hiện nhóm bài của mục đó, không tải lại trang. Bấm kèm Ctrl/Cmd/Shift hoặc chuột giữa thì để trình duyệt tự mở liên kết.
  (function () {
    var root = document.querySelector("[data-news]");
    if (!root) return;
    var tabs = root.querySelectorAll("[data-news-tab]");
    var panels = root.querySelectorAll("[data-news-panel]");
    var all = root.querySelector("[data-news-all]");
    tabs.forEach(function (tab) {
      tab.addEventListener("click", function (event) {
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || event.button !== 0) return;
        event.preventDefault();
        var slug = tab.getAttribute("data-news-tab");
        tabs.forEach(function (t) {
          if (t === tab) t.setAttribute("aria-current", "true");
          else t.removeAttribute("aria-current");
        });
        panels.forEach(function (panel) {
          panel.hidden = panel.getAttribute("data-news-panel") !== slug;
        });
        if (all) all.setAttribute("href", tab.getAttribute("href"));
      });
    });
  })();
</script>
