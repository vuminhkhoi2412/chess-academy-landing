---
// src/components/home/NewsSection.astro
// Khối tin: một bài lớn bên trái, ba bài nhỏ bên phải, cùng rìa với banner (max-w-6xl, px-4).
// Trang chủ chỉ dựng khối này khi có bài đã đăng. Chia mục (Tin tức/Kiến thức) thêm ở đợt 3.
import { ArrowRight } from "lucide-react";
import type { Post, PostImage } from "../../server/posts";

interface Props {
  items: { post: Post; cover: PostImage | null }[];
}
const { items } = Astro.props;
const [lead, ...rest] = items;

const date = (ms: number) =>
  new Intl.DateTimeFormat("vi-VN", { timeZone: "Asia/Ho_Chi_Minh", dateStyle: "long" }).format(ms);
---

<section id="tin-tuc" class="border-t border-slate-200 bg-white py-14">
  <div class="mx-auto max-w-6xl px-4">
    <div class="flex items-end justify-between gap-4">
      <h2 class="gc-section-title text-3xl font-extrabold md:text-4xl">Tin tức</h2>
      <a href="/news" class="inline-flex min-h-11 items-center gap-1.5 text-sm font-bold text-brand-800 hover:underline">
        Xem tất cả <ArrowRight className="h-3.5 w-3.5" aria-hidden="true" />
      </a>
    </div>

    <div class="mt-6 grid gap-6 lg:grid-cols-12">
      <a href={`/news/${lead.post.slug}`} class="group lg:col-span-7">
        {
          lead.cover ? (
            <img src={`/uploads/${lead.cover.file}`} alt="" width="800" height="450" loading="lazy" class="aspect-video w-full rounded-lg bg-slate-100 object-cover" />
          ) : (
            <div class="aspect-video w-full rounded-lg bg-brand-50" aria-hidden="true"></div>
          )
        }
        <p class="mt-3 text-xs font-bold text-slate-600">{date(lead.post.publishedAt ?? lead.post.createdAt)}</p>
        <h3 class="mt-1 text-2xl font-extrabold leading-tight text-slate-900 group-hover:underline">{lead.post.title}</h3>
        {lead.post.summary && <p class="mt-2 leading-relaxed text-slate-700">{lead.post.summary}</p>}
      </a>

      {
        rest.length > 0 && (
          <ul class="grid list-none content-start gap-5 lg:col-span-5">
            {rest.map(({ post, cover }) => (
              <li>
                <a href={`/news/${post.slug}`} class="group grid grid-cols-[7rem_1fr] gap-4">
                  {cover ? (
                    <img src={`/uploads/${cover.file}`} alt="" width="224" height="168" loading="lazy" class="aspect-[4/3] w-full rounded-lg bg-slate-100 object-cover" />
                  ) : (
                    <div class="aspect-[4/3] w-full rounded-lg bg-brand-50" aria-hidden="true"></div>
                  )}
                  <div>
                    <p class="text-xs font-bold text-slate-600">{date(post.publishedAt ?? post.createdAt)}</p>
                    <h3 class="mt-0.5 text-base font-bold leading-snug text-slate-900 group-hover:underline">{post.title}</h3>
                  </div>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </div>
</section>
