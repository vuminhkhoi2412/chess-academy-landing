---
// src/components/home/IntroSection.astro
// Giới thiệu ngắn về trung tâm. Nội dung giới thiệu do quản lý brand gửi sau nên đang là khối
// TODO có nhãn (PRODUCT.md: không bịa nội dung). Số liệu lấy từ dữ liệu thật.
import { Image } from "astro:assets";
import { MapPin, Trophy, Clock } from "lucide-react";
import { BRANCHES, CURRICULUM_PROGRAMS, TESTIMONIALS } from "../../data/courses";
import faceBe1 from "../../assets/images/anh_chan_dung/chan_dung_be_1.jpg";
import faceBe2 from "../../assets/images/anh_chan_dung/chan_dung_be_2.jpg";
import faceBe3 from "../../assets/images/anh_chan_dung/chan_dung_be_3.jpg";

interface Props {
  testimonials: boolean;
}
const { testimonials } = Astro.props;

// totalDuration bắt đầu bằng số buổi ("72 buổi (...)").
const stats = [
  { Icon: MapPin, value: BRANCHES.length, label: "cơ sở tại TP.HCM" },
  { Icon: Trophy, value: CURRICULUM_PROGRAMS.reduce((n, p) => n + p.subLevels.length, 0), label: "cấp độ nối tiếp" },
  { Icon: Clock, value: CURRICULUM_PROGRAMS.reduce((n, p) => n + parseInt(p.totalDuration), 0), label: "buổi học toàn lộ trình" },
];

// Ảnh gốc là chân dung dọc nên phóng to quanh khuôn mặt: `pos` là object-position,
// `origin` là tâm khuôn mặt, `zoom` là mức phóng. Đổi ảnh thì chỉnh lại ba số này.
const faces = [
  { src: faceBe1, pos: "50% 0%", origin: "50% 49%", zoom: 2.0 },
  { src: faceBe2, pos: "50% 0%", origin: "44% 44%", zoom: 1.7 },
  { src: faceBe3, pos: "50% 0%", origin: "52% 37%", zoom: 1.3 },
];
const quote = TESTIMONIALS[0];
---

<section id="gioi-thieu" class="border-t border-slate-200 bg-white py-14">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 lg:grid-cols-12 lg:gap-12">
    <div class="lg:col-span-7">
      <h2 class="gc-section-title text-3xl font-extrabold md:text-4xl">Giới thiệu Global Chess</h2>
      <p class="mt-4 max-w-prose text-base leading-relaxed text-slate-600">
        Trung tâm cờ vua cho trẻ em, học trực tiếp và online, với lộ trình chuẩn hoá giống nhau ở cả năm cơ sở.
      </p>
      {/* TODO có nhãn: thay bằng nội dung giới thiệu của quản lý brand khi nhận được. */}
      <p class="mt-4 max-w-prose rounded-lg border border-dashed border-slate-300 bg-cream px-4 py-3 text-sm text-slate-600">
        <strong class="text-slate-800">Đang chờ nội dung:</strong> phần giới thiệu chi tiết về trung tâm sẽ do quản lý thương hiệu cung cấp.
      </p>

      <dl class="mt-6 grid max-w-lg grid-cols-3 overflow-hidden rounded-lg border border-slate-200/90 bg-cream">
        {
          stats.map((s) => (
            <div class="flex flex-col-reverse gap-0.5 border-l border-slate-200/90 px-4 py-3.5 first:border-l-0">
              <dt class="text-xs text-slate-600">{s.label}</dt>
              <dd class="text-[1.75rem] font-extrabold leading-tight tabular-nums">{s.value}</dd>
              <s.Icon className="mb-1.5 h-5 w-5 text-amber-700" aria-hidden="true" />
            </div>
          ))
        }
      </dl>
    </div>

    {
      testimonials && (
        <div class="flex flex-wrap content-center items-center gap-4 lg:col-span-5">
          <div class="flex" aria-hidden="true">
            {faces.map((f) => (
              <span class="-ml-3 block h-[3.25rem] w-[3.25rem] shrink-0 overflow-hidden rounded-full border-2 border-white bg-brand-600 first:ml-0">
                <Image
                  src={f.src}
                  alt=""
                  width={240}
                  class="h-full w-full object-cover"
                  style={`object-position:${f.pos};transform:scale(${f.zoom});transform-origin:${f.origin}`}
                />
              </span>
            ))}
          </div>
          <figure class="min-w-56 flex-1 border-l-[3px] border-amber-500 pl-3">
            <blockquote class="text-[15px] font-medium leading-snug text-slate-700">“{quote.quote}”</blockquote>
            <figcaption class="mt-1 text-xs text-slate-600">{quote.author} · {quote.branch}</figcaption>
          </figure>
        </div>
      )
    }
  </div>
</section>
