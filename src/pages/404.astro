---
// src/pages/404.astro
// Astro tự phục vụ file này cho mọi đường dẫn không khớp.
// Không import `../data/payment` ở đây: trang lỗi không cần tới biến môi trường ngân hàng.
import "../styles/global.css";
import { BRAND_INFO, BRANCHES } from "../data/courses";
import { ArrowLeft, Phone, MapPin } from "lucide-react";

const pageTitle = `Không tìm thấy trang – ${BRAND_INFO.name}`;
const pageDescription =
  "Đường dẫn này không tồn tại. Quay về trang chủ Global Chess để xem lộ trình 48 buổi, 5 cơ sở tại TP.HCM và học phí.";
---

<html lang="vi" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="robots" content="noindex, follow" />
    <meta name="theme-color" content="#184268" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&family=Bricolage+Grotesque:opsz,wght@12..96,400..800&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="antialiased min-h-dvh flex flex-col">
    <main class="flex-1 flex items-center justify-center px-4 py-16">
      <div class="w-full max-w-2xl">
        <p class="font-display text-7xl md:text-9xl font-extrabold tracking-tight text-amber-500/90 tabular-nums">
          404
        </p>

        <h1 class="mt-2 text-2xl md:text-3xl font-extrabold text-slate-900">
          Nước này không có trên bàn cờ
        </h1>

        <p class="mt-3 text-sm md:text-base text-slate-600 leading-relaxed max-w-lg">
          Đường dẫn bạn mở không tồn tại hoặc đã được đổi. Quay về trang chủ để xem lộ trình
          48 buổi, 5 cơ sở tại TP.HCM và học phí.
        </p>

        <div class="mt-7 flex flex-wrap gap-3">
          <a
            href="/"
            class="inline-flex items-center gap-2 bg-brand-800 hover:bg-brand-700 active:scale-[0.98] text-white font-bold px-5 py-3 rounded-control text-sm shadow-lifted transition"
          >
            <ArrowLeft className="w-4 h-4 text-amber-400" aria-hidden="true" /> Về trang chủ
          </a>
          <a
            href="/#pricing"
            class="inline-flex items-center gap-2 bg-white hover:bg-slate-100 active:scale-[0.98] text-slate-800 border border-slate-300 font-semibold px-5 py-3 rounded-control text-sm shadow-soft transition"
          >
            Xem học phí &amp; giữ chỗ
          </a>
        </div>

        <div class="mt-10 pt-6 border-t border-slate-200 grid sm:grid-cols-2 gap-4 text-sm">
          <div>
            <div class="font-bold uppercase tracking-wider text-slate-400 mb-2">Hotline tư vấn</div>
            <div class="flex flex-col gap-1.5 font-semibold text-slate-700">
              {BRAND_INFO.hotlines.map((hotline) => (
                <a
                  href={`tel:${hotline.replace(/\./g, "")}`}
                  class="inline-flex items-center gap-1.5 hover:text-amber-700 hover:underline tabular-nums w-fit"
                >
                  <Phone className="w-3.5 h-3.5 text-amber-600" aria-hidden="true" /> {hotline}
                </a>
              ))}
            </div>
          </div>
          <div>
            <div class="font-bold uppercase tracking-wider text-slate-400 mb-2">Cơ sở đang mở lớp</div>
            <ul class="space-y-1.5 text-slate-600 list-none">
              {BRANCHES.slice(0, 3).map((branch) => (
                <li class="flex items-start gap-1.5">
                  <MapPin className="w-3.5 h-3.5 text-amber-600 shrink-0 mt-0.5" aria-hidden="true" />
                  <span>{branch.name}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </main>
  </body>
</html>
