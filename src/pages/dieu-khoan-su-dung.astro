---
// src/pages/dieu-khoan-su-dung.astro
//
// LƯU Ý CHO NGƯỜI BẢO TRÌ: bản này mô tả đúng luồng thực tế của trang tĩnh.
// Trước khi mở rộng sang thanh toán tự động, hoàn tiền hay dữ liệu học viên trên
// backend, hãy để bên pháp lý rà lại và bổ sung thông tin pháp nhân.
import SiteHeader from "../components/SiteHeader.astro";
import Layout from "../layouts/Layout.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { BRAND_INFO } from "../data/courses";
import { Phone } from "lucide-react";

const pageTitle = `Điều khoản sử dụng – ${BRAND_INFO.name}`;
const pageDescription =
  "Điều khoản sử dụng trang web và điều kiện đăng ký giữ chỗ, học phí, bảo lưu khoá học tại Global Chess.";
const updatedAt = "16/10/2026";
---

<Layout title={pageTitle} description={pageDescription}>
    <SiteHeader variant="document" />

    <main id="main" tabindex="-1" class="max-w-3xl mx-auto px-4 py-12 md:py-16">
      <p class="text-xs font-bold uppercase tracking-wider text-amber-700">Cập nhật lần cuối: {updatedAt}</p>
      <h1 class="mt-2 text-3xl md:text-4xl font-extrabold text-slate-900">Điều khoản sử dụng</h1>
      <p class="mt-3 text-base text-slate-600 leading-relaxed">
        Khi dùng trang web này và đăng ký giữ chỗ cho bé, bạn đồng ý với các điều khoản dưới đây.
      </p>

      <div class="mt-10 space-y-8 text-base text-slate-700 leading-relaxed">
        <section>
          <h2 class="text-lg md:text-xl font-bold text-slate-900">1. Giá và thông tin hiển thị</h2>
          <p class="mt-2">
            Học phí và lộ trình trên trang là thông tin tham khảo tại thời điểm bạn xem. Con số cuối
            cùng do giáo vụ xác nhận qua hotline hoặc Zalo trước khi bé vào lớp. Nếu có sai lệch,
            mức giá đã được giáo vụ xác nhận là mức áp dụng.
          </p>
        </section>

        <section>
          <h2 class="text-lg md:text-xl font-bold text-slate-900">2. Đăng ký và giữ chỗ</h2>
          <p class="mt-2">
            Gửi form trên trang là đăng ký để được tư vấn, chưa phải giữ chỗ. Chỗ học chỉ được giữ
            sau khi trung tâm xác nhận trực tiếp với bạn. Học phí và hình thức đóng do hai bên trao
            đổi ngoài website; trang không nhận thanh toán.
          </p>
        </section>

        <section>
          <h2 class="text-lg md:text-xl font-bold text-slate-900">3. Xếp lớp và đổi lịch</h2>
          <p class="mt-2">
            Khung giờ bạn chọn là nguyện vọng, không phải lịch đã chốt. Giáo vụ sẽ sắp lớp theo trình
            độ và số lượng học viên thực tế. Trường hợp phải đổi cơ sở hoặc đổi ca, trung tâm sẽ báo
            trước cho phụ huynh.
          </p>
        </section>

        <section>
          <h2 class="text-lg md:text-xl font-bold text-slate-900">4. Bảo lưu</h2>
          <p class="mt-2">
            Bé có thể bảo lưu khi ốm hoặc có việc gia đình. Phụ huynh báo trước cho giáo vụ để sắp
            buổi học bù. Thời hạn bảo lưu và số buổi được bù tối đa do trung tâm quy định tại từng
            thời điểm.
          </p>
        </section>

        <section>
          <h2 class="text-lg md:text-xl font-bold text-slate-900">5. Nội dung trên trang</h2>
          <p class="mt-2">
            Giáo trình, mô tả buổi học và bài đố cờ vua thuộc {BRAND_INFO.name}. Vui lòng không sao
            chép để dùng cho trung tâm khác khi chưa có sự đồng ý.
          </p>
        </section>

        <section>
          <h2 class="text-lg md:text-xl font-bold text-slate-900">6. Giới hạn trách nhiệm</h2>
          <p class="mt-2">
            Trang web được cung cấp nguyên trạng. Chúng tôi cố gắng giữ thông tin chính xác nhưng
            không cam kết trang luôn không có lỗi hay mọi lần gửi form đều tới được trung tâm. Nếu
            bạn chưa được liên hệ lại, hãy nhắn Zalo hoặc gọi hotline bên dưới.
          </p>
        </section>

        <section>
          <h2 class="text-lg md:text-xl font-bold text-slate-900">7. Liên hệ</h2>
          <div class="mt-2 flex flex-col gap-1.5">
            {BRAND_INFO.hotlines.map((hotline) => (
              <a
                href={`tel:${hotline.replace(/\./g, "")}`}
                class="inline-flex min-h-11 items-center gap-1.5 font-semibold text-amber-700 hover:underline tabular-nums w-fit"
              >
                <Phone className="w-4 h-4" aria-hidden="true" /> {hotline}
              </a>
            ))}
          </div>
        </section>
      </div>

      <p class="mt-12 pt-6 border-t border-slate-200 text-xs text-slate-600">
        Xem thêm <a href="/chinh-sach-bao-mat" class="font-semibold text-amber-700 hover:underline">Chính sách bảo mật</a>.
      </p>
    </main>

    <SiteFooter />
</Layout>
