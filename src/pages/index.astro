---
// src/pages/index.astro
import { Image, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import InteractivePuzzle from "../components/InteractivePuzzle";
import CurriculumExplorer from "../components/CurriculumExplorer";
import PricingAndCheckout from "../components/PricingAndCheckout";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import MobileContactBar from "../components/MobileContactBar.astro";
import Layout from "../layouts/Layout.astro";
import { BRAND_INFO, BRANCHES, TUITION_PROGRAMS, TUITION_LEVELS, TESTIMONIALS, FAQS, OPERATING_POINTS } from "../data/courses";
import galleryCoachStudent from "../assets/images/gallery-coach-student.jpg";
import galleryClassCoach from "../assets/images/gallery-class-coach.jpg";
import galleryTournamentPlay from "../assets/images/gallery-tournament-play.jpg";
import galleryClassPractice from "../assets/images/gallery-class-practice.jpg";
import galleryClassroom from "../assets/images/gallery-classroom.jpg";
import branchBinhTan from "../assets/images/branch_images/Binh_Tan.jpg";
import branchQuan6 from "../assets/images/branch_images/Quan_6.jpg";
import branchTayThanh from "../assets/images/branch_images/Tay_Thanh_Tan_Phu.jpg";
import branchNguyenSon from "../assets/images/branch_images/Nguyen_Son_Tan_Phu.jpg";
import branchVinhomes from "../assets/images/branch_images/Vinhome.jpg";
import {
  MapPin,
  Phone,
  ArrowRight,
  ArrowUpRight,
  Quote,
  BookOpen,
  Clock,
  Trophy,
  HelpCircle,
  ChevronDown,
  AlertTriangle,
} from "lucide-react";

// Ảnh gallery theo thứ tự trong lưới bento (ảnh đầu là ảnh vuông chiếm hai hàng).
// `full` là bản tối đa 1600px (không phóng quá kích thước gốc) tối ưu sẵn khi build, dùng cho hộp phóng to; không có JS thì link mở thẳng ảnh này.
const GALLERY_SOURCES = [
  { src: galleryClassPractice, alt: "Các học viên Global Chess đối kháng trên bàn cờ trong lớp học.", cls: "aspect-square md:row-span-2" },
  { src: galleryCoachStudent, alt: "Huấn luyện viên Global Chess hướng dẫn một học viên trong giờ học cờ vua.", pos: "object-[50%_8%]" },
  { src: galleryTournamentPlay, alt: "Học viên tập trung thi đấu trên bàn cờ trong giải đấu nội bộ Global Chess." },
  { src: galleryClassroom, alt: "Phòng học cờ vua tại một cơ sở Global Chess, các học viên đang luyện tập." },
  { src: galleryClassCoach, alt: "Giáo viên đứng lớp và theo dõi các học viên luyện tập cờ vua tại Global Chess." },
];
const GALLERY = await Promise.all(
  GALLERY_SOURCES.map(async (photo) => ({
    ...photo,
    full: (await getImage({ src: photo.src, width: Math.min(1600, photo.src.width), quality: 82 })).src,
  })),
);

// Ảnh từng cơ sở. Cơ sở nào chưa có ảnh thì thẻ rơi về ô bàn cờ có mã cơ sở.
const BRANCH_PHOTOS: Record<string, { src: ImageMetadata; alt: string; pos?: string }> = {
  CS1: { src: branchQuan6, alt: "Các học viên chơi cờ vua trong phòng học Global Chess." },
  CS2: { src: branchBinhTan, alt: "Các học viên chơi cờ vua trong phòng học tại cơ sở Bình Tân." },
  CS3: { src: branchTayThanh, alt: "Các học viên đang đấu cờ vua trong phòng học." },
  CS4: { src: branchNguyenSon, alt: "Học viên chơi cờ vua cùng huấn luyện viên trong phòng học.", pos: "object-[50%_35%]" },
  CS5: { src: branchVinhomes, alt: "Giải cờ vua thiếu nhi Vincom Kids Challenge 2026 tại Vincom Grand Park." },
};

/** "0963091208" → "0963 091 208" cho dễ đọc; số tel: vẫn giữ dạng liền. */
const fmtPhone = (p: string) => p.replace(/(\d{4})(\d{3})(\d{3})/, "$1 $2 $3");

// Domain lấy từ `site` trong astro.config.mjs.
// Sửa một chỗ đó là canonical, og:url, sitemap.xml và robots.txt cùng đúng theo.
const origin = Astro.site ?? Astro.url;
const canonicalUrl = new URL(Astro.url.pathname, origin).href;
const ogImageUrl = new URL("/og-image.png", origin).href;
const logoUrl = new URL("/favicon.svg", origin).href;

const pageTitle = `${BRAND_INFO.name} – ${BRAND_INFO.slogan1}`;
const pageDescription =
  "Trung tâm cờ vua Global Chess cho trẻ 4–12 tuổi tại TP.HCM: lộ trình Happy Chess 72 buổi và Global Sơ cấp & Trung cấp 48 buổi, lớp tối trong tuần và cuối tuần tại 5 cơ sở.";

// "0789.059.440" -> "+84789059440"
const toE164 = (phone: string) => `+84${phone.replace(/\./g, "").replace(/^0/, "")}`;
const hotlineE164 = toE164(BRAND_INFO.hotlines[0]);

const structuredData = {
  "@context": "https://schema.org",
  "@type": "EducationalOrganization",
  name: BRAND_INFO.name,
  slogan: BRAND_INFO.slogan1,
  description: pageDescription,
  url: canonicalUrl,
  image: ogImageUrl,
  logo: logoUrl,
  telephone: hotlineE164,
  areaServed: { "@type": "City", name: "TP.HCM" },
  department: BRANCHES.map((branch) => ({
    "@type": "EducationalOrganization",
    name: branch.name,
    telephone: toE164(branch.phone),
    hasMap: branch.mapUrl,
    address: {
      "@type": "PostalAddress",
      streetAddress: branch.address,
      addressLocality: "TP.HCM",
      addressCountry: "VN",
    },
  })),
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Khóa học cờ vua",
    itemListElement: TUITION_PROGRAMS.map((program) => {
      const levels = TUITION_LEVELS.filter((level) => level.programId === program.id);
      return {
        "@type": "AggregateOffer",
        name: program.name,
        description: program.subtitle,
        lowPrice: Math.min(...levels.map((level) => level.group12)),
        highPrice: Math.max(...levels.map((level) => level.group24)),
        priceCurrency: "VND",
        offerCount: levels.length * 2,
        url: canonicalUrl,
      };
    }),
  },
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  robots="index, follow, max-image-preview:large"
  bodyClass="pb-[calc(4.75rem+env(safe-area-inset-bottom))] md:pb-0"
>
  <script
    slot="head"
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(structuredData).replace(/</g, "\\u003c")}
  />

    <!-- Top Hotline Bar -->
    <div class="bg-brand-800 text-brand-100 text-xs py-2 px-4">
      <div class="max-w-6xl mx-auto flex flex-wrap items-center justify-between gap-2">
        <span class="font-medium text-amber-400">Lớp tối trong tuần &amp; cuối tuần • 5 cơ sở tại TP.HCM</span>
        <div class="flex items-center gap-4">
          <span class="flex items-center gap-1.5">
            <Phone className="w-3.5 h-3.5 text-amber-400" aria-hidden="true" />
            <span>Hotline: <strong>{BRAND_INFO.hotlines[0]}</strong> – <strong>{BRAND_INFO.hotlines[1]}</strong></span>
          </span>
        </div>
      </div>
    </div>

    <!-- Navbar -->
    <SiteHeader />

    <main id="main" tabindex="-1">
    <!-- Hero Section -->
    <section class="relative isolate overflow-hidden py-14 md:py-20">
      <!--
        Depth is built entirely from geometry: a warm/cool mesh, a chessboard plane
        receding in perspective, move notation as texture, and a light grain.
        No stock photography and nothing that pretends to be a real classroom.

        Ảnh lớp học thật nằm ở gallery #hinh-anh bên dưới (đã có sự đồng ý của
        phụ huynh). Hero giữ bàn cờ tương tác thay vì dùng ảnh lớn.
      -->
      <div aria-hidden="true" class="gc-hero-fade pointer-events-none absolute inset-0 -z-10">
        <div class="gc-hero-mesh absolute inset-0"></div>
        <div
          class="gc-board-field gc-hero-board absolute -right-28 -top-44 h-[46rem] w-[46rem] opacity-[0.075] [--gc-cell:4.5rem]"
        >
        </div>
        <div class="gc-grain absolute inset-0 opacity-[0.045]"></div>
      </div>

      <div class="max-w-6xl mx-auto px-4 grid md:grid-cols-12 gap-10 md:gap-8 lg:gap-12 items-center">
        <div class="md:col-span-6 lg:col-span-7 space-y-5">
          <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-[0.9375rem] leading-6 font-semibold tracking-[-0.005em]">
            <span aria-hidden="true" class="h-0.5 w-7 bg-amber-500 rounded-full"></span>
            <span class="text-amber-700">Đào tạo cờ vua trực tiếp <span class="tabular-nums whitespace-nowrap">(4 – 12 tuổi)</span></span>
          </div>

          <!--
            Khoá 2 dòng có chủ đích: dòng 1 màu đậm, dòng 2 màu hổ phách, nên màu chữ
            trùng với nhịp xuống dòng ở mọi khổ màn hình thay vì ngắt tuỳ tiện.
          -->
          <h1 class="text-5xl sm:text-6xl lg:text-7xl xl:text-8xl font-extrabold tracking-tight leading-[1.08]">
            <span class="block text-slate-900">Một Nước Đi,</span>
            <span class="block text-amber-600">Mở Tư Duy</span>
          </h1>

          <p class="text-slate-600 text-base leading-relaxed max-w-xl">
            Ba lộ trình chuẩn hóa <strong>Happy Chess (72 buổi)</strong> và <strong>Global Chess Sơ Cấp &amp; Trung Cấp (48 buổi)</strong> giúp trẻ đi từ luật chơi cơ bản đến làm chủ các hệ thống khai cuộc và đòn chiến thuật trung – tàn cuộc.
          </p>

          <div class="flex flex-wrap items-center gap-x-6 gap-y-2 pt-2">
            {/*
              Một hành động chính duy nhất trong hero. Nút phụ cũ cùng cỡ, cùng bo
              góc, chữ căn giữa đứng cạnh nó khiến hai lựa chọn trông ngang hàng
              nhau; nay lối xem lộ trình lùi về thành một liên kết có gạch chân.
            */}
            <a href="#pricing" class="gc-move gc-move--navy gc-move--lg">
              <span class="gc-move__label">Đăng ký tư vấn</span>
              <span class="gc-move__go" aria-hidden="true"><ArrowRight className="w-4 h-4" /></span>
            </a>
            <a href="#curriculum" class="gc-ref min-h-11">
              Xem chi tiết lộ trình
              <ArrowRight className="w-3.5 h-3.5" aria-hidden="true" />
            </a>
          </div>

          <!--
            Hai cột đầu chia đều, cột thứ ba ăn theo nội dung. "5 Địa Điểm" ở
            text-2xl rộng hơn 1/3 hàng, nên nếu chia đều ba cột thì nó buộc phải
            xuống dòng (hoặc tràn ra ngoài khi chặn xuống dòng).
          -->
          {/*
            Ở md (768–1023px) cột chữ của hero chỉ rộng ~352px, chia ba cột thì
            mỗi ô còn ~98px trong khi "60–90 phút" cần 145px và tràn sang ô bên
            cạnh. Khoảng đó dùng hai cột; từ lg cột chữ rộng lại nên trả về ba.
          */}
          <dl class="grid grid-cols-[repeat(2,minmax(0,1fr))_auto] gap-3 sm:gap-4 md:grid-cols-2 lg:grid-cols-[repeat(2,minmax(0,1fr))_auto] pt-5 border-t border-slate-300/70 max-w-lg">
            <div>
              <dt class="text-xs text-slate-600">Lộ trình Global</dt>
              <dd class="text-xl md:text-2xl font-extrabold text-slate-900 tabular-nums whitespace-nowrap">48 Buổi</dd>
            </div>
            <div>
              <dt class="text-xs text-slate-600">Mỗi buổi học</dt>
              <dd class="text-xl md:text-2xl font-extrabold text-slate-900 tabular-nums whitespace-nowrap">60–90 phút</dd>
            </div>
            <div>
              <dt class="text-xs text-slate-600">Cơ sở tại TP.HCM</dt>
              <dd class="text-xl md:text-2xl font-extrabold text-slate-900 tabular-nums whitespace-nowrap">5 Địa Điểm</dd>
            </div>
          </dl>
        </div>

        <!-- Interactive Chessboard Island, lifted off the page with a soft ground shadow -->
        <div class="md:col-span-6 lg:col-span-5 relative lg:mt-2">
          <div
            aria-hidden="true"
            class="absolute inset-x-8 -bottom-4 top-10 rounded-card bg-brand-900/15 blur-2xl"
          >
          </div>
          <div class="relative">
            <InteractivePuzzle client:load />
          </div>
        </div>
      </div>
    </section>

    <!-- Interactive Curriculum Explorer (Sơ cấp 1-2 & Trung cấp Q1-Q2) -->
    <CurriculumExplorer client:load />

    <!-- Hệ thống các cơ sở -->
    <section id="branches" class="py-16 bg-white border-t border-slate-200">
      <div class="max-w-6xl mx-auto px-4">
        <div class="text-center max-w-2xl mx-auto mb-12">
          <span class="gc-eyebrow">Hệ thống phòng học tiêu chuẩn</span>
          <h2 class="gc-section-title text-3xl md:text-4xl lg:text-5xl font-extrabold mt-3">Hệ thống các cơ sở</h2>
          <p class="text-base text-slate-600 mt-3 max-w-prose mx-auto">
            Các ca học trong tuần và cuối tuần được tổ chức linh hoạt theo trình độ của học viên tại từng cơ sở.
          </p>
          {/*
            Tình trạng tuyển sinh nói một lần ở đây. Trước đây mỗi thẻ cơ sở đều gắn
            nhãn "Đang tuyển sinh" giống hệt nhau, lặp 5 lần mà không thêm thông tin.
          */}
          <p class="mt-4 inline-flex items-center gap-1.5 text-xs font-semibold text-emerald-700">
            <span aria-hidden="true" class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
            Cả 5 cơ sở đang tuyển sinh
          </p>
        </div>

        {/*
          Mỗi thẻ có khung ảnh 16:9. Cơ sở chưa có ảnh riêng dùng ô bàn cờ cùng tỉ lệ
          để các thẻ vẫn đều chiều cao. Hotline ra khỏi lưới thành banner riêng để
          không bị đọc nhầm là "Cơ sở 6".
        */}
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {BRANCHES.map((branch, idx) => {
            const photo = BRANCH_PHOTOS[branch.id];
            const phone = branch.phone ?? BRAND_INFO.hotlines[0];
            return (
              <article class="flex flex-col overflow-hidden rounded-card border border-slate-200/90 bg-white transition hover:border-slate-300 hover:shadow-soft">
                <div class="relative aspect-video overflow-hidden bg-brand-800">
                  {photo ? (
                    <Image
                      src={photo.src}
                      alt={photo.alt}
                      widths={[400, 640, 960]}
                      sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
                      quality={80}
                      loading="lazy"
                      decoding="async"
                      class={`h-full w-full object-cover ${photo.pos ?? ""}`}
                    />
                  ) : (
                    <>
                      <span aria-hidden="true" class="gc-board-field absolute inset-0 opacity-[0.08] [--gc-cell:2.25rem] [--gc-cell-color:#fff]"></span>
                      <span aria-hidden="true" class="absolute inset-0 grid place-items-center font-display text-5xl font-extrabold tracking-tight text-white/90">{branch.id}</span>
                    </>
                  )}
                  <div class="absolute left-3 top-3 flex gap-1 text-xs font-bold">
                    <span class="rounded-full bg-white px-2.5 py-0.5 text-slate-800 shadow-sm tabular-nums">Cơ sở {idx + 1}</span>
                    <span class="rounded-full bg-white px-2.5 py-0.5 text-slate-600 shadow-sm">{branch.district}</span>
                  </div>
                </div>
                <div class="flex flex-1 flex-col p-5">
                  <h3 class="font-display text-lg font-extrabold leading-tight tracking-[-0.015em] text-slate-900">{branch.name}</h3>
                  <p class="mt-2 flex items-start gap-2 text-sm leading-relaxed text-slate-600">
                    <MapPin className="mt-0.5 h-4 w-4 shrink-0 text-amber-700" aria-hidden="true" />
                    <span>{branch.address}</span>
                  </p>
                  <p class="flex items-center gap-2 text-sm text-slate-600">
                    <Phone className="h-4 w-4 shrink-0 text-amber-700" aria-hidden="true" />
                    <a
                      href={`tel:${phone}`}
                      class="inline-flex min-h-11 items-center font-semibold text-slate-900 tabular-nums hover:underline"
                      aria-label={`Gọi ${branch.name}`}
                    >
                      {fmtPhone(phone)}
                    </a>
                    {!branch.phone && <span class="text-xs text-slate-500">Hotline chung</span>}
                  </p>
                  <div class="mt-auto flex flex-wrap items-center gap-2 pt-3">
                    <a
                      href={branch.mapUrl ?? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(branch.address)}`}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex min-h-11 items-center gap-1.5 rounded-control border border-slate-300 bg-white px-3.5 text-sm font-bold text-brand-800 transition hover:border-brand-800 hover:bg-brand-50"
                      aria-label={`Chỉ đường đến ${branch.name} (mở tab mới)`}
                    >
                      Chỉ đường <ArrowUpRight className="h-3.5 w-3.5" aria-hidden="true" />
                    </a>
                    {/* Nhãn đọc được phải chứa đúng chữ hiển thị "Chọn cơ sở này"; tên cơ sở nối thêm để phân biệt các thẻ. */}
                    <a
                      href="#pricing"
                      data-branch={branch.id}
                      class="js-choose-branch inline-flex min-h-11 items-center gap-1.5 rounded-control bg-brand-800 px-3.5 text-sm font-bold text-white transition hover:bg-brand-900"
                      aria-label={`Chọn cơ sở này – ${branch.name}`}
                    >
                      Chọn cơ sở này <ArrowRight className="h-3.5 w-3.5" aria-hidden="true" />
                    </a>
                  </div>
                </div>
              </article>
            );
          })}
        </div>

        {/* Hotline xếp lớp: một dòng kẻ mảnh, không hộp, để không tranh với lưới cơ sở. */}
        <aside
          aria-label="Tư vấn xếp lớp"
          class="mt-10 flex flex-wrap items-center justify-center gap-x-5 gap-y-1 border-y border-slate-200 py-2 text-center text-[15px]"
        >
          <b class="font-display font-extrabold tracking-[-0.01em] text-slate-900">Chưa chắc chọn cơ sở nào?</b>
          <span class="text-slate-500">Gọi giáo vụ để được xếp lớp:</span>
          {BRAND_INFO.hotlines.map((hotline) => (
            <a
              href={`tel:${hotline}`}
              class="inline-flex min-h-11 items-center gap-1.5 font-bold text-brand-800 tabular-nums hover:underline"
            >
              <Phone className="h-3.5 w-3.5 text-amber-700" aria-hidden="true" /> {fmtPhone(hotline)}
            </a>
          ))}
        </aside>
      </div>
    </section>

    <!--
      Gallery ảnh thật: 5 ảnh lớp học/giải đấu do trung tâm cung cấp, đã có sự
      đồng ý của phụ huynh. Ảnh gốc nằm ở assets/nguon/hinh-anh/; bản trong
      src/assets/images/ đã crop bỏ banner/logo in sẵn trên ảnh.

      Không dùng ảnh stock và không gắn tên cơ sở: nguồn ảnh không ghi rõ ảnh
      chụp tại cơ sở nào, nên caption/alt chỉ mô tả đúng những gì nhìn thấy.
    -->
    <section id="hinh-anh" class="py-16 bg-cream border-t border-slate-200">
      <div class="max-w-6xl mx-auto px-4">
        <div class="grid lg:grid-cols-12 gap-4 lg:gap-8 lg:items-end">
          <div class="lg:col-span-7">
            <span class="gc-eyebrow">Thư viện hình ảnh</span>
            <h2 class="gc-section-title text-3xl md:text-4xl lg:text-5xl font-extrabold mt-3">Hình ảnh trung tâm</h2>
          </div>
          <p class="lg:col-span-5 text-base text-slate-600 leading-relaxed lg:pb-1">
            Những khoảnh khắc trong lớp Happy Chess và Global Chess.
          </p>
        </div>

        {/*
          Lưới bento 3 cột: ảnh vuông chiếm hai hàng và quyết định chiều cao, bốn ảnh
          còn lại lấp hai cột sau nên khối ảnh là một hình chữ nhật phẳng, không còn
          khoảng trống giữa phần mô tả và ảnh. Ảnh nằm tuyệt đối trong khung nên bốn ô
          nhỏ bị cắt (object-cover); ảnh huấn luyện viên neo phía trên để giữ biển Global Chess.
          Mỗi ảnh là một link tới bản lớn; JS bắt click để mở hộp phóng to (#gallery-lightbox).
          Trên mobile ảnh xếp thành một cột theo đúng thứ tự trong DOM.
        */}
        <div class="mt-10 grid gap-4 md:grid-cols-3">
          {GALLERY.map((photo) => (
            <figure
              class:list={[
                "relative overflow-hidden rounded-card bg-slate-100 ring-1 ring-slate-900/5",
                photo.cls ?? "aspect-[4/3] md:aspect-auto",
              ]}
            >
              <a
                href={photo.full}
                class="js-zoom absolute inset-0 block cursor-zoom-in focus-visible:outline-offset-[-3px]"
                aria-label={`Phóng to ảnh: ${photo.alt}`}
                data-alt={photo.alt}
              >
                <Image
                  src={photo.src}
                  alt={photo.alt}
                  widths={[480, 720, 1080]}
                  sizes="(min-width: 768px) 33vw, 100vw"
                  quality={82}
                  loading="lazy"
                  decoding="async"
                  class:list={["h-full w-full object-cover", photo.pos]}
                />
              </a>
            </figure>
          ))}
        </div>

        <p class="mt-6 text-xs text-slate-500 leading-relaxed">
          Ảnh chụp tại lớp học và giải đấu nội bộ Global Chess. Phụ huynh của các học viên trong ảnh đã đồng ý cho trung tâm sử dụng trên website.
        </p>

        {/* Hộp phóng to: <dialog> gốc nên có sẵn Esc, khoá tương tác nền và trả focus về ảnh đã bấm. Ảnh được tạo bằng JS. */}
        <dialog
          id="gallery-lightbox"
          aria-label="Xem ảnh phóng to"
          class="m-auto w-full max-w-5xl bg-transparent p-0 text-white backdrop:bg-brand-950/90"
        >
          <figure>
            <figcaption class="mt-3 px-4 text-sm text-brand-200 md:px-0"></figcaption>
          </figure>
          <button
            type="button"
            class="js-zoom-close absolute right-2 top-2 grid size-11 place-items-center rounded-full bg-brand-950/80 text-2xl leading-none text-white"
            aria-label="Đóng ảnh"
          >
            ×
          </button>
        </dialog>
      </div>
    </section>

    <!--
      Vận hành lớp học. Đây là phần "social proof" trung thực: ba điểm khác biệt
      đều lấy từ dữ liệu vận hành có thật trong src/data/courses.ts, không phải
      lời khen tự đánh giá hay con số bịa.
    -->
    <section id="phuong-phap" class="py-16 bg-white">
      <div class="max-w-6xl mx-auto px-4">
        <div class="max-w-2xl">
          <span class="gc-eyebrow">Vận hành lớp học</span>
          <h2 class="gc-section-title text-3xl md:text-4xl lg:text-5xl font-extrabold mt-3">Môi trường học tập</h2>
        </div>
        <ul class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5 mt-10 list-none">
          {OPERATING_POINTS.map((point) => (
            <li class="gc-op-card bg-cream rounded-card border border-slate-200/90 p-5">
              <span class="gc-op-icon inline-flex items-center justify-center rounded-control bg-brand-800 text-amber-400 shrink-0 mb-3 w-9 h-9" aria-hidden="true">
                {point.icon === "book" && <BookOpen className="w-4 h-4" />}
                {point.icon === "clock" && <Clock className="w-4 h-4" />}
                {point.icon === "trophy" && <Trophy className="w-4 h-4" />}
              </span>
              <h3 class="font-bold text-slate-900 text-base">{point.title}</h3>
              <p class="text-base text-slate-600 mt-1.5 leading-relaxed">{point.desc}</p>
            </li>
          ))}
        </ul>
      </div>
  </section>

    <!--
      Nhận xét phụ huynh. Nội dung thật nằm trong TESTIMONIALS (src/data/courses.ts).
      Nếu mảng rỗng, phần này tự hiển thị ô TODO rất rõ để không thể vô tình đưa
      lên production.
    -->
    <section id="phu-huynh" class="py-16 border-t border-slate-200">
      <div class="max-w-6xl mx-auto px-4">
        <div class="grid gap-4 lg:grid-cols-12 lg:items-end mb-10">
          <div class="lg:col-span-8">
            <span class="gc-eyebrow">Nhận xét phụ huynh</span>
            <h2 class="gc-section-title text-3xl md:text-4xl lg:text-5xl font-extrabold mt-3">Phụ huynh nói gì về Global Chess</h2>
          </div>
          <p class="lg:col-span-4 text-sm text-slate-600 leading-relaxed lg:pb-1 lg:text-right">
            Trích nguyên văn chia sẻ của phụ huynh, ghi theo cơ sở bé đang học.
          </p>
        </div>

        {TESTIMONIALS.length === 0 ? (
          <div class="rounded-card border-2 border-dashed border-amber-400 bg-amber-50/70 p-6 md:p-8">
            <div class="flex items-start gap-3">
              <AlertTriangle className="w-5 h-5 text-amber-700 shrink-0 mt-0.5" aria-hidden="true" />
              <div>
                <p class="font-bold text-amber-900">
                  Khu vực này chưa có nội dung thật — không đăng trang khi còn như vậy.
                </p>
                <p class="text-sm text-amber-900/80 mt-1.5 leading-relaxed">
                  Xin câu trích dẫn thật từ phụ huynh (kèm tên và cơ sở), rồi điền vào mảng{" "}
                  <code class="rounded bg-amber-200/70 px-1.5 py-0.5 font-mono text-[0.85em]">TESTIMONIALS</code> trong{" "}
                  <code class="rounded bg-amber-200/70 px-1.5 py-0.5 font-mono text-[0.85em]">src/data/courses.ts</code>.
                  Điền đủ 3 mục là phần này tự chuyển sang bản hoàn chỉnh.
                </p>
              </div>
            </div>

            <ul class="grid md:grid-cols-3 gap-5 mt-8 list-none">
              {[1, 2, 3].map((slot) => (
                <li class="rounded-card border-2 border-dashed border-amber-300 bg-white/70 p-5 flex flex-col justify-between min-h-[190px]">
                  <div>
                    <Quote className="w-6 h-6 text-amber-300" aria-hidden="true" />
                    <p class="mt-3 text-sm font-semibold text-amber-900 italic">
                      Chỗ dành cho nhận xét thật của phụ huynh #{slot}
                    </p>
                  </div>
                  <div class="mt-4 pt-3 border-t border-dashed border-amber-300 text-xs text-amber-900 space-y-1">
                    <div>Tên phụ huynh: <span class="font-bold">TODO</span></div>
                    <div>Cơ sở: <span class="font-bold">TODO</span></div>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        ) : (
          <div class="gc-quotes" role="region" aria-label="Nhận xét phụ huynh" tabindex="0">
            {TESTIMONIALS.map((item, idx) => (
              <figure
                class:list={[
                  "gc-quotes__card rounded-card p-6 lg:p-7",
                  idx === 0 ? "bg-brand-800 text-white" : "border border-slate-200 bg-white",
                ]}
              >
                <Quote className={idx === 0 ? "w-6 h-6 text-amber-400" : "w-6 h-6 text-amber-500"} aria-hidden="true" />
                <blockquote class:list={["mt-4 text-base leading-relaxed lg:text-lg", idx === 0 ? "text-brand-100" : "text-slate-700"]}>
                  {item.quote}
                </blockquote>
                <figcaption class:list={["mt-6 border-t pt-4", idx === 0 ? "border-brand-600" : "border-slate-200"]}>
                  <div class:list={["font-bold", idx === 0 ? "text-white" : "text-sm text-slate-900"]}>{item.author}</div>
                  <div class:list={["mt-0.5", idx === 0 ? "text-sm text-brand-200" : "text-xs text-slate-600"]}>{item.role} • {item.branch}</div>
                </figcaption>
              </figure>
            ))}
          </div>
        )}
      </div>
    </section>

    <!--
      Câu hỏi thường gặp. Dùng <details> gốc nên bàn phím, trình đọc màn hình và
      Ctrl+F đều hoạt động mà không cần script; mỗi câu mở độc lập.
    -->
    <section id="faq" class="py-16 bg-white border-t border-slate-200">
      <div class="max-w-6xl mx-auto px-4">
        <div class="max-w-2xl">
          <span class="gc-eyebrow">Giải đáp trước khi đăng ký</span>
          <h2 class="gc-section-title text-3xl md:text-4xl lg:text-5xl font-extrabold mt-3">Câu hỏi thường gặp</h2>
        </div>

        <div class="grid md:grid-cols-2 gap-x-10 items-start mt-10">
          {FAQS.map((item) => (
            <details class="gc-faq group border-t border-slate-200">
              <summary class="flex min-h-11 cursor-pointer list-none items-start gap-2 py-4 font-bold text-slate-900 text-base [&::-webkit-details-marker]:hidden">
                <HelpCircle className="w-4 h-4 text-amber-600 shrink-0 mt-1" aria-hidden="true" />
                <span class="flex-1">{item.q}</span>
                <ChevronDown className="w-4 h-4 text-slate-500 shrink-0 mt-1 group-open:rotate-180" aria-hidden="true" />
              </summary>
              <p class="text-base text-slate-600 pb-5 leading-relaxed pl-6">{item.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- Pricing & Enrolment Form -->
    <PricingAndCheckout client:load />
    </main>

    <SiteFooter />

    <MobileContactBar />

    <script is:inline>
      // Progressive enhancement: clicking a branch card opens the checkout modal
      // with that branch already selected. Without JS the anchor still jumps to #pricing.
      // Phóng to ảnh gallery: bấm ảnh mở hộp #gallery-lightbox; bấm nền hoặc nút × để đóng.
      // Không có JS thì link của ảnh mở thẳng bản lớn.
      document.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        const dialog = document.getElementById("gallery-lightbox");
        if (!(dialog instanceof HTMLDialogElement)) return;
        if (target === dialog || target.closest(".js-zoom-close")) {
          dialog.close();
          return;
        }
        const zoom = target.closest(".js-zoom");
        if (!(zoom instanceof HTMLAnchorElement)) return;
        event.preventDefault();
        const figure = dialog.querySelector("figure");
        const big = new Image();
        big.src = zoom.href;
        big.alt = zoom.dataset.alt || "";
        big.className = "max-h-[80vh] w-full rounded-card object-contain";
        figure.querySelector("img")?.remove();
        figure.prepend(big);
        figure.querySelector("figcaption").textContent = big.alt;
        dialog.showModal();
      });

      document.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        const trigger = target.closest(".js-choose-branch");
        if (!(trigger instanceof HTMLElement)) return;
        const branchId = trigger.dataset.branch;
        if (!branchId) return;
        window.dispatchEvent(
          new CustomEvent("gc:choose-branch", {
            detail: { branchId, trigger: trigger },
          })
        );
      });
    </script>
</Layout>
