---
export const prerender = false;
// src/pages/index.astro
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import MobileContactBar from "../components/MobileContactBar.astro";
import HomeBanner from "../components/home/HomeBanner.astro";
import NewsSection from "../components/home/NewsSection.astro";
import BranchesSection from "../components/home/BranchesSection.astro";
import GallerySection from "../components/home/GallerySection.astro";
import TestimonialsSection from "../components/home/TestimonialsSection.astro";
import FaqSection from "../components/home/FaqSection.astro";
import CurriculumExplorer from "../components/CurriculumExplorer";
import PricingAndCheckout from "../components/PricingAndCheckout";
import Layout from "../layouts/Layout.astro";
import { getSiteConfig, getHomeSlides, getLatestPosts, getNewsAvailability, getTuition } from "../server/site-config";
import { BRAND_INFO, BRANCHES, TUITION_PROGRAMS, TESTIMONIALS } from "../data/courses";

// Cấu hình bật/tắt đọc ở MỖI request (trang này chạy trên server), nên đổi trong /admin có hiệu lực ngay.
const { flags, banner } = getSiteConfig();
const latestPosts = getLatestPosts(4);
const { news, knowledge } = getNewsAvailability();
const slides = getHomeSlides();
const tuition = getTuition();

// Hết nhận xét thật thì không được đăng trang (thay cho ô TODO cũ).
if (TESTIMONIALS.length === 0) throw new Error("TESTIMONIALS đang rỗng: cần ít nhất một nhận xét thật của phụ huynh.");

// Domain lấy từ `site` trong astro.config.mjs.
// Sửa một chỗ đó là canonical, og:url, sitemap.xml và robots.txt cùng đúng theo.
const origin = Astro.site ?? Astro.url;
const canonicalUrl = new URL(Astro.url.pathname, origin).href;
const ogImageUrl = new URL("/og-image.png", origin).href;
const logoUrl = new URL("/favicon.svg", origin).href;

const pageTitle = `${BRAND_INFO.name} – ${BRAND_INFO.slogan1}`;
const pageDescription =
  "Trung tâm cờ vua Global Chess cho trẻ 4–12 tuổi tại TP.HCM: lộ trình Happy Chess 72 buổi và Global Sơ cấp & Trung cấp 48 buổi, lớp tối trong tuần và cuối tuần tại 5 cơ sở.";

// "0789.059.440" -> "+84789059440"
const toE164 = (phone: string) => `+84${phone.replace(/\./g, "").replace(/^0/, "")}`;
const hotlineE164 = toE164(BRAND_INFO.hotlines[0]);

const structuredData = {
  "@context": "https://schema.org",
  "@type": "EducationalOrganization",
  name: BRAND_INFO.name,
  slogan: BRAND_INFO.slogan1,
  description: pageDescription,
  url: canonicalUrl,
  image: ogImageUrl,
  logo: logoUrl,
  telephone: hotlineE164,
  areaServed: { "@type": "City", name: "TP.HCM" },
  department: BRANCHES.map((branch) => ({
    "@type": "EducationalOrganization",
    name: branch.name,
    telephone: toE164(branch.phone),
    hasMap: branch.mapUrl,
    address: {
      "@type": "PostalAddress",
      streetAddress: branch.address,
      addressLocality: "TP.HCM",
      addressCountry: "VN",
    },
  })),
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Khóa học cờ vua",
    itemListElement: TUITION_PROGRAMS.map((program) => {
      const levels = tuition.levels.filter((level) => level.programId === program.id);
      return {
        "@type": "AggregateOffer",
        name: program.name,
        description: program.subtitle,
        lowPrice: Math.min(...levels.map((level) => level.group12)),
        highPrice: Math.max(...levels.map((level) => level.group24)),
        priceCurrency: "VND",
        offerCount: levels.length * 2,
        url: canonicalUrl,
      };
    }),
  },
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  robots="index, follow, max-image-preview:large"
  bodyClass={flags.mobile_bar ? "pb-[calc(4.75rem+env(safe-area-inset-bottom))] md:pb-0" : undefined}
>
  {/*
    Phông riêng của vé xác nhận (chỉ trang chủ có vé). Trình duyệt chỉ tải tệp phông khi chữ dùng nó
    xuất hiện trên trang, nên khi chưa gửi đăng ký thì chỉ tải phần CSS khai báo. Đều có tập con tiếng Việt.
  */}
  <link
    slot="head"
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Cormorant+SC:wght@700&display=swap"
  />
  <script
    slot="head"
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(structuredData).replace(/</g, "\\u003c")}
  />

    {banner && (
      <div role="region" aria-label="Thông báo" class="bg-amber-400 text-slate-950 px-4 py-2.5 text-center text-sm font-bold">
        {banner}
      </div>
    )}


    <SiteHeader enrolmentOpen={flags.enrolment} news={news} knowledge={knowledge} />

    <main id="main" tabindex="-1">
    <HomeBanner enrolment={flags.enrolment} news={news} knowledge={knowledge} puzzle={flags.puzzle} slides={slides} />

    {latestPosts.length > 0 && <NewsSection items={latestPosts} news={news} knowledge={knowledge} />}

    <!-- Interactive Curriculum Explorer (Sơ cấp 1-2 & Trung cấp Q1-Q2) -->
    <CurriculumExplorer client:load />

    <BranchesSection enrolment={flags.enrolment} />

    {flags.gallery && <GallerySection />}

    {flags.testimonials && <TestimonialsSection />}

    {flags.faq && <FaqSection fees={tuition.extras} />}

    <!-- Pricing & Enrolment Form -->
    <PricingAndCheckout client:load enrolmentOpen={flags.enrolment} levels={tuition.levels} />
    </main>

    <SiteFooter faq={flags.faq} news={latestPosts.length > 0} />

    {flags.mobile_bar && <MobileContactBar />}
</Layout>
