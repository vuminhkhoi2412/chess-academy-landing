---
// src/pages/index.astro
import { Image } from "astro:assets";
import InteractivePuzzle from "../components/InteractivePuzzle";
import CurriculumExplorer from "../components/CurriculumExplorer";
import PricingAndCheckout from "../components/PricingAndCheckout";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import MobileContactBar from "../components/MobileContactBar.astro";
import Layout from "../layouts/Layout.astro";
import { BRAND_INFO, BRANCHES, TUITION_PROGRAMS, TUITION_LEVELS, TESTIMONIALS, FAQS, OPERATING_POINTS } from "../data/courses";
import galleryCoachStudent from "../assets/images/gallery-coach-student.jpg";
import galleryClassCoach from "../assets/images/gallery-class-coach.jpg";
import galleryTournamentPlay from "../assets/images/gallery-tournament-play.jpg";
import galleryClassPractice from "../assets/images/gallery-class-practice.jpg";
import galleryClassroom from "../assets/images/gallery-classroom.jpg";
import {
  MapPin,
  Phone,
  ArrowRight,
  Sparkles,
  Quote,
  BookOpen,
  ListChecks,
  Clock,
  Trophy,
  HelpCircle,
  AlertTriangle,
} from "lucide-react";

// Domain lấy từ `site` trong astro.config.mjs.
// Sửa một chỗ đó là canonical, og:url, sitemap.xml và robots.txt cùng đúng theo.
const origin = Astro.site ?? Astro.url;
const canonicalUrl = new URL(Astro.url.pathname, origin).href;
const ogImageUrl = new URL("/og-image.png", origin).href;
const logoUrl = new URL("/favicon.svg", origin).href;

const pageTitle = `${BRAND_INFO.name} – ${BRAND_INFO.slogan1}`;
const pageDescription =
  "Trung tâm cờ vua Global Chess cho trẻ 4–12 tuổi tại TP.HCM: lộ trình Happy Chess 72 buổi và Global Sơ cấp & Trung cấp 48 buổi, lớp tối trong tuần và cuối tuần tại 5 cơ sở.";

// "0789.059.440" -> "+84789059440"
const hotlineE164 = `+84${BRAND_INFO.hotlines[0].replace(/\./g, "").replace(/^0/, "")}`;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "EducationalOrganization",
  name: BRAND_INFO.name,
  slogan: BRAND_INFO.slogan1,
  description: pageDescription,
  url: canonicalUrl,
  image: ogImageUrl,
  logo: logoUrl,
  telephone: hotlineE164,
  areaServed: { "@type": "City", name: "TP.HCM" },
  department: BRANCHES.map((branch) => ({
    "@type": "Place",
    name: branch.name,
    address: {
      "@type": "PostalAddress",
      streetAddress: branch.address,
      addressLocality: "TP.HCM",
      addressCountry: "VN",
    },
  })),
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Khóa học cờ vua",
    itemListElement: TUITION_PROGRAMS.map((program) => {
      const levels = TUITION_LEVELS.filter((level) => level.programId === program.id);
      return {
        "@type": "AggregateOffer",
        name: program.name,
        description: program.subtitle,
        lowPrice: Math.min(...levels.map((level) => level.group12)),
        highPrice: Math.max(...levels.map((level) => level.group24)),
        priceCurrency: "VND",
        offerCount: levels.length * 2,
        url: canonicalUrl,
      };
    }),
  },
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  robots="index, follow, max-image-preview:large"
  bodyClass="pb-[calc(4.75rem+env(safe-area-inset-bottom))] md:pb-0"
>
  <script
    slot="head"
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(structuredData).replace(/</g, "\\u003c")}
  />

    <!-- Top Hotline Bar -->
    <div class="bg-brand-800 text-brand-100 text-xs py-2 px-4">
      <div class="max-w-6xl mx-auto flex flex-wrap items-center justify-between gap-2">
        <span class="font-medium text-amber-400">{BRAND_INFO.slogan1} – {BRAND_INFO.slogan2}</span>
        <div class="flex items-center gap-4">
          <span class="flex items-center gap-1.5">
            <Phone className="w-3.5 h-3.5 text-amber-400" aria-hidden="true" />
            <span>Hotline: <strong>{BRAND_INFO.hotlines[0]}</strong> – <strong>{BRAND_INFO.hotlines[1]}</strong></span>
          </span>
        </div>
      </div>
    </div>

    <!-- Navbar -->
    <SiteHeader />

    <main id="main" tabindex="-1">
    <!-- Hero Section -->
    <section class="relative isolate overflow-hidden py-14 md:py-20">
      <!--
        Depth is built entirely from geometry: a warm/cool mesh, a chessboard plane
        receding in perspective, move notation as texture, and a light grain.
        No stock photography and nothing that pretends to be a real classroom.

        Ảnh lớp học thật nằm ở gallery #hinh-anh bên dưới (đã có sự đồng ý của
        phụ huynh). Hero giữ bàn cờ tương tác thay vì dùng ảnh lớn.
      -->
      <div aria-hidden="true" class="gc-hero-fade pointer-events-none absolute inset-0 -z-10">
        <div class="gc-hero-mesh absolute inset-0"></div>
        <div
          class="gc-board-field gc-hero-board absolute -right-28 -top-44 h-[46rem] w-[46rem] opacity-[0.075] [--gc-cell:4.5rem]"
        >
        </div>
        <div class="gc-grain absolute inset-0 opacity-[0.045]"></div>
      </div>

      <div class="max-w-6xl mx-auto px-4 grid md:grid-cols-12 gap-10 md:gap-8 lg:gap-12 items-center">
        <div class="md:col-span-6 lg:col-span-7 space-y-5">
          <div class="inline-flex items-center gap-2 bg-amber-100 border border-amber-300 text-amber-900 px-3.5 py-1.5 rounded-control text-xs font-bold">
            <Sparkles className="w-3.5 h-3.5 text-amber-700" aria-hidden="true" />
            Đào tạo Cờ Vua Trực Tiếp (4 – 12 tuổi) • 5 Cơ sở tại TP.HCM
          </div>

          <!--
            Khoá 2 dòng có chủ đích: dòng 1 màu đậm, dòng 2 màu hổ phách, nên màu chữ
            trùng với nhịp xuống dòng ở mọi khổ màn hình thay vì ngắt tuỳ tiện.
          -->
          <h1 class="text-5xl sm:text-6xl lg:text-7xl xl:text-8xl font-extrabold tracking-tight leading-[1.08]">
            <span class="block text-slate-900">Một Nước Đi,</span>
            <span class="block text-amber-600">Mở Tư Duy</span>
          </h1>

          <p class="text-slate-600 text-base leading-relaxed max-w-xl">
            Ba lộ trình chuẩn hóa <strong>Happy Chess (72 buổi)</strong> và <strong>Global Chess Sơ Cấp &amp; Trung Cấp (48 buổi)</strong> giúp trẻ đi từ luật chơi cơ bản đến làm chủ các hệ thống khai cuộc và đòn chiến thuật trung – tàn cuộc.
          </p>

          <div class="flex flex-wrap gap-3.5 pt-2">
            <a
              href="#pricing"
              class="bg-brand-800 hover:bg-brand-700 active:scale-[0.98] text-white font-bold px-6 py-3.5 rounded-control text-sm flex items-center gap-2 shadow-lifted transition"
            >
              Đăng ký &amp; Đóng học phí qua QR <ArrowRight className="w-4 h-4 text-amber-400" aria-hidden="true" />
            </a>
            <a
              href="#curriculum"
              class="bg-white/80 hover:bg-white active:scale-[0.98] text-slate-800 border border-slate-300 font-semibold px-6 py-3.5 rounded-control text-sm transition shadow-soft backdrop-blur-sm"
            >
              Xem chi tiết 48 buổi học
            </a>
          </div>

          <!--
            Hai cột đầu chia đều, cột thứ ba ăn theo nội dung. "5 Địa Điểm" ở
            text-2xl rộng hơn 1/3 hàng, nên nếu chia đều ba cột thì nó buộc phải
            xuống dòng (hoặc tràn ra ngoài khi chặn xuống dòng).
          -->
          <dl class="grid grid-cols-[repeat(2,minmax(0,1fr))_auto] gap-3 sm:gap-4 pt-5 border-t border-slate-300/70 max-w-lg">
            <div>
              <dt class="text-xs text-slate-600">Lộ trình chuẩn</dt>
              <dd class="text-xl md:text-2xl font-extrabold text-slate-900 tabular-nums whitespace-nowrap">48 – 72 Buổi</dd>
            </div>
            <div>
              <dt class="text-xs text-slate-600">Mỗi buổi học</dt>
              <dd class="text-xl md:text-2xl font-extrabold text-slate-900 tabular-nums whitespace-nowrap">60 – 90'</dd>
            </div>
            <div>
              <dt class="text-xs text-slate-600">Cơ sở tại TP.HCM</dt>
              <dd class="text-xl md:text-2xl font-extrabold text-slate-900 tabular-nums whitespace-nowrap">5 Địa Điểm</dd>
            </div>
          </dl>
        </div>

        <!-- Interactive Chessboard Island, lifted off the page with a soft ground shadow -->
        <div class="md:col-span-6 lg:col-span-5 relative lg:mt-2">
          <div
            aria-hidden="true"
            class="absolute inset-x-8 -bottom-4 top-10 rounded-card bg-brand-900/15 blur-2xl"
          >
          </div>
          <div class="relative">
            <InteractivePuzzle client:load />
          </div>
        </div>
      </div>
    </section>

    <!-- Interactive Curriculum Explorer (Sơ cấp 1-2 & Trung cấp Q1-Q2) -->
    <CurriculumExplorer client:load />

    <!-- Hệ thống 5 Cơ sở Global Chess tại TP.HCM -->
    <section id="branches" class="py-16 bg-white border-t border-slate-200">
      <div class="max-w-6xl mx-auto px-4">
        <div class="text-center max-w-2xl mx-auto mb-12">
          <span class="gc-eyebrow">Hệ thống phòng học tiêu chuẩn</span>
          <h2 class="gc-section-title text-3xl md:text-4xl lg:text-5xl font-extrabold mt-3">5 Cơ Sở Global Chess Tại TP.HCM</h2>
          <p class="text-base text-slate-600 mt-3 max-w-prose mx-auto">
            Các ca học trong tuần và cuối tuần được tổ chức linh hoạt theo trình độ của học viên tại từng cơ sở.
          </p>
          {/*
            Tình trạng tuyển sinh nói một lần ở đây. Trước đây mỗi thẻ cơ sở đều gắn
            nhãn "Đang tuyển sinh" giống hệt nhau, lặp 5 lần mà không thêm thông tin.
          */}
          <p class="mt-4 inline-flex items-center gap-1.5 text-xs font-semibold text-emerald-700">
            <span aria-hidden="true" class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
            Cả 5 cơ sở đang tuyển sinh
          </p>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
          {BRANCHES.map((branch, idx) => (
            <div
              class:list={[
                "bg-cream p-5 rounded-card border border-slate-200/90 flex flex-col justify-between hover:border-amber-400 hover:shadow-soft transition",
                // Bento: cơ sở đầu tiên trải 2 cột để lưới không còn là 6 ô đều nhau.
                idx === 0 && "lg:col-span-2 relative overflow-hidden",
              ]}
            >
              {idx === 0 && (
                <span
                  aria-hidden="true"
                  class="gc-board-field pointer-events-none absolute -right-10 -bottom-12 h-48 w-48 rounded-full opacity-[0.06] [--gc-cell:1.5rem]"
                >
                </span>
              )}
              <div class="relative">
                <div class="flex items-center justify-between mb-3">
                  <span class="text-xs font-extrabold text-amber-800 bg-amber-100 px-2.5 py-1 rounded-md tabular-nums">
                    Cơ sở {idx + 1}
                  </span>
                  {/* Nhãn riêng của từng cơ sở, thay cho nhãn trạng thái lặp 5 lần. */}
                  <span class="text-xs font-semibold text-slate-600 border border-slate-300/80 px-2 py-0.5 rounded-control">
                    {branch.district}
                  </span>
                </div>
                <h3 class:list={["font-bold text-slate-900 mb-1", idx === 0 ? "text-lg" : "text-base"]}>{branch.name}</h3>
                <p class="text-sm text-slate-600 flex items-start gap-1.5 leading-relaxed">
                  <MapPin className="w-4 h-4 text-amber-600 shrink-0 mt-0.5" aria-hidden="true" />
                  <span>{branch.address}</span>
                </p>
              </div>
              <div class="relative mt-4 pt-3 border-t border-slate-200/70 flex items-center justify-between gap-2 text-sm">
                <span class="text-slate-600">Lịch học: Trong tuần &amp; T7-CN</span>
                {/*
                  Nhãn đọc được phải chứa đúng chữ hiển thị "Chọn cơ sở này", nếu không
                  trình đọc màn hình báo lệch nhãn. Tên cơ sở nối thêm để phân biệt
                  5 thẻ giống hệt nhau.
                */}
                <a
                  href="#pricing"
                  data-branch={branch.id}
                  class="js-choose-branch group inline-flex items-center gap-1 font-bold text-amber-700 hover:text-amber-800 hover:underline transition"
                  aria-label={`Chọn cơ sở này – ${branch.name}`}
                >
                  Chọn cơ sở này
                  <ArrowRight className="w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5" aria-hidden="true" />
                </a>
              </div>
            </div>
          ))}

          <!-- Thẻ Hotline tư vấn xếp lớp nhanh: lấp nửa cuối hàng 2 của lưới bento -->
          <div class="lg:col-span-2 bg-brand-800 text-white p-5 rounded-card flex flex-col justify-between">
            <div>
              <span class="text-xs font-bold uppercase tracking-wider text-amber-400">Hỗ trợ xếp lớp nhanh</span>
              <h3 class="font-bold text-base mt-1 mb-2">Cần Tư Vấn Kiểm Tra Trình Độ Đầu Vào?</h3>
              <p class="text-sm text-brand-200 leading-relaxed">
                Liên hệ trực tiếp Hotline để bộ phận giáo vụ kiểm tra ca học đang mở sát với trình độ và khu vực nhà bạn nhất.
              </p>
            </div>
            <div class="mt-4 pt-3 border-t border-brand-600 flex flex-col gap-1.5 text-sm font-bold text-amber-400">
              <a href={`tel:${BRAND_INFO.hotlines[0].replace(/\./g, "")}`} class="inline-flex items-center gap-1.5 hover:underline tabular-nums">
                <Phone className="w-3.5 h-3.5" aria-hidden="true" /> Hotline 1: {BRAND_INFO.hotlines[0]}
              </a>
              <a href={`tel:${BRAND_INFO.hotlines[1].replace(/\./g, "")}`} class="inline-flex items-center gap-1.5 hover:underline tabular-nums">
                <Phone className="w-3.5 h-3.5" aria-hidden="true" /> Hotline 2: {BRAND_INFO.hotlines[1]}
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!--
      Gallery ảnh thật: 5 ảnh lớp học/giải đấu do trung tâm cung cấp, đã có sự
      đồng ý của phụ huynh. Ảnh gốc nằm ở assets/nguon/hinh-anh/; bản trong
      src/assets/images/ đã crop bỏ banner/logo in sẵn trên ảnh.

      Không dùng ảnh stock và không gắn tên cơ sở: nguồn ảnh không ghi rõ ảnh
      chụp tại cơ sở nào, nên caption/alt chỉ mô tả đúng những gì nhìn thấy.
    -->
    <section id="hinh-anh" class="py-16 bg-cream border-t border-slate-200">
      <div class="max-w-6xl mx-auto px-4">
        <div class="grid lg:grid-cols-12 gap-4 lg:gap-8 lg:items-end">
          <div class="lg:col-span-7">
            <span class="gc-eyebrow">Hình ảnh thật tại Global Chess</span>
            <h2 class="gc-section-title text-3xl md:text-4xl lg:text-5xl font-extrabold mt-3">Lớp Học Thật, Bàn Cờ Thật</h2>
          </div>
          <p class="lg:col-span-5 text-base text-slate-600 leading-relaxed lg:pb-1">
            Những khoảnh khắc trong lớp Happy Chess và Global Chess: huấn luyện viên kèm từng thế cờ, học viên luyện đối kháng và không gian học tại cơ sở.
          </p>
        </div>

        {/*
          Hai cột lệch: cột trái dẫn bằng ảnh lớn, cột phải bắt đầu thấp hơn để
          mắt không đọc thành một lưới ảnh đều nhau. Trên mobile, ảnh xếp thành
          một cột theo đúng thứ tự trong DOM.
        */}
        <div class="grid md:grid-cols-2 gap-4 md:gap-6 mt-10 items-start">
          <div class="space-y-4 md:space-y-6">
            <figure class="overflow-hidden rounded-card bg-slate-100 ring-1 ring-slate-900/5">
              <Image
                src={galleryCoachStudent}
                alt="Huấn luyện viên Global Chess hướng dẫn một học viên trong giờ học cờ vua."
                widths={[480, 720, 1200]}
                sizes="(min-width: 768px) 50vw, 100vw"
                quality={82}
                loading="lazy"
                decoding="async"
                class="w-full h-auto"
              />
            </figure>

            <figure class="overflow-hidden rounded-card bg-slate-100 ring-1 ring-slate-900/5">
              <Image
                src={galleryClassroom}
                alt="Phòng học cờ vua tại một cơ sở Global Chess, các học viên đang luyện tập."
                widths={[480, 720, 1200]}
                sizes="(min-width: 768px) 50vw, 100vw"
                quality={82}
                loading="lazy"
                decoding="async"
                class="w-full h-auto"
              />
            </figure>

            <figure class="overflow-hidden rounded-card bg-slate-100 ring-1 ring-slate-900/5">
              <Image
                src={galleryClassCoach}
                alt="Giáo viên đứng lớp và theo dõi các học viên luyện tập cờ vua tại Global Chess."
                widths={[480, 720, 1200]}
                sizes="(min-width: 768px) 50vw, 100vw"
                quality={82}
                loading="lazy"
                decoding="async"
                class="w-full h-auto"
              />
            </figure>
          </div>

          <div class="space-y-4 md:space-y-6 md:pt-12">
            <figure class="overflow-hidden rounded-card bg-slate-100 ring-1 ring-slate-900/5">
              <Image
                src={galleryClassPractice}
                alt="Các học viên Global Chess đối kháng trên bàn cờ trong lớp học."
                widths={[360, 540, 900, 1080]}
                sizes="(min-width: 768px) 50vw, 100vw"
                quality={82}
                loading="lazy"
                decoding="async"
                class="w-full h-auto"
              />
            </figure>

            <figure class="overflow-hidden rounded-card bg-slate-100 ring-1 ring-slate-900/5">
              <Image
                src={galleryTournamentPlay}
                alt="Học viên tập trung thi đấu trên bàn cờ trong giải đấu nội bộ Global Chess."
                widths={[360, 540, 900, 1080]}
                sizes="(min-width: 768px) 50vw, 100vw"
                quality={82}
                loading="lazy"
                decoding="async"
                class="w-full h-auto"
              />
            </figure>

            {/* Thêm lối tắt về địa chỉ cơ sở, đồng thời cân chiều cao cột phải. */}
            <div class="rounded-card bg-brand-800 p-5 text-white">
              <p class="text-xs font-bold uppercase tracking-wider text-amber-400">5 cơ sở tại TP.HCM</p>
              <p class="mt-1.5 text-sm font-bold">Chọn cơ sở gần nhà</p>
              <p class="mt-1 text-sm text-brand-200 leading-relaxed">
                Lịch học trong tuần và cuối tuần, xếp lớp theo trình độ của học viên.
              </p>
              <a
                href="#branches"
                class="mt-3 inline-flex items-center gap-1 text-xs font-bold text-amber-400 hover:text-amber-300 hover:underline transition"
              >
                Xem địa chỉ 5 cơ sở
                <ArrowRight className="w-3.5 h-3.5" aria-hidden="true" />
              </a>
            </div>
          </div>
        </div>

        <p class="mt-6 text-xs text-slate-500 leading-relaxed">
          Ảnh chụp tại lớp học và giải đấu nội bộ Global Chess. Phụ huynh của các học viên trong ảnh đã đồng ý cho trung tâm sử dụng trên website.
        </p>
      </div>
    </section>

    <!--
      Vận hành lớp học. Đây là phần "social proof" trung thực: bốn điểm khác biệt
      đều lấy từ dữ liệu vận hành có thật trong src/data/courses.ts, không phải
      lời khen tự đánh giá hay con số bịa.
    -->
    <section id="phuong-phap" class="py-16 bg-white">
      <div class="max-w-6xl mx-auto px-4">
        <div class="max-w-2xl">
          <span class="gc-eyebrow">Vận hành lớp học</span>
          <h2 class="gc-section-title text-3xl md:text-4xl lg:text-5xl font-extrabold mt-3">Global Chess Khác Gì Lớp Cờ Tự Phát?</h2>
          <p class="text-base text-slate-600 mt-3 max-w-prose">
            Bốn điểm dưới đây là cách trung tâm tổ chức lớp học, không phải lời tự khen.
          </p>
        </div>

        {/*
          Bốn điểm vận hành xếp theo nhịp 7-5-5-7 trên lưới 12 cột: hàng nào cũng
          lệch, nên mắt không đọc thành bốn ô giống hệt nhau. Hai thẻ rộng dùng bố
          cục ngang (biểu tượng bên cạnh chữ) để phần rộng thêm có lý do.
        */}
        <ul class="grid sm:grid-cols-2 lg:grid-cols-12 gap-5 mt-10 list-none">
          {OPERATING_POINTS.map((point, idx) => {
            const isWide = idx % 4 === 0 || idx % 4 === 3;
            return (
              <li
                class:list={[
                  "bg-cream rounded-card border border-slate-200/90 p-5",
                  // Bố cục ngang chỉ bật từ lg, khi thẻ thật sự rộng. Dưới lg, cả
                  // bốn thẻ giữ nguyên một dáng để không thành hai kiểu thẻ lẫn lộn.
                  isWide ? "lg:col-span-7 lg:flex lg:items-start lg:gap-4" : "lg:col-span-5",
                ]}
              >
                <span
                  class:list={[
                    "inline-flex items-center justify-center rounded-control bg-brand-800 text-amber-400 shrink-0 mb-3 lg:mb-0",
                    isWide ? "w-11 h-11" : "w-9 h-9",
                  ]}
                  aria-hidden="true"
                >
                  {point.icon === "book" && <BookOpen className={isWide ? "w-5 h-5" : "w-4 h-4"} />}
                  {point.icon === "steps" && <ListChecks className={isWide ? "w-5 h-5" : "w-4 h-4"} />}
                  {point.icon === "clock" && <Clock className={isWide ? "w-5 h-5" : "w-4 h-4"} />}
                  {point.icon === "trophy" && <Trophy className={isWide ? "w-5 h-5" : "w-4 h-4"} />}
                </span>
                <div>
                  <h3 class:list={["font-bold text-slate-900", isWide ? "text-lg" : "text-base"]}>{point.title}</h3>
                  <p class="text-sm text-slate-600 mt-1.5 leading-relaxed">{point.desc}</p>
                </div>
              </li>
            );
          })}
        </ul>
      </div>
    </section>

    <!--
      Nhận xét phụ huynh. Nội dung thật nằm trong TESTIMONIALS (src/data/courses.ts).
      Nếu mảng rỗng, phần này tự hiển thị ô TODO rất rõ để không thể vô tình đưa
      lên production.
    -->
    <section id="phu-huynh" class="py-16 border-t border-slate-200">
      <div class="max-w-6xl mx-auto px-4">
        <div class="text-center max-w-2xl mx-auto mb-10">
          <span class="gc-eyebrow">Nhận xét phụ huynh</span>
          <h2 class="gc-section-title text-3xl md:text-4xl lg:text-5xl font-extrabold mt-3">Phụ Huynh Nói Gì Về Global Chess</h2>
        </div>

        {TESTIMONIALS.length === 0 ? (
          <div class="rounded-card border-2 border-dashed border-amber-400 bg-amber-50/70 p-6 md:p-8">
            <div class="flex items-start gap-3">
              <AlertTriangle className="w-5 h-5 text-amber-700 shrink-0 mt-0.5" aria-hidden="true" />
              <div>
                <p class="font-bold text-amber-900">
                  Khu vực này chưa có nội dung thật — không đăng trang khi còn như vậy.
                </p>
                <p class="text-sm text-amber-900/80 mt-1.5 leading-relaxed">
                  Xin câu trích dẫn thật từ phụ huynh (kèm tên và cơ sở), rồi điền vào mảng{" "}
                  <code class="rounded bg-amber-200/70 px-1.5 py-0.5 font-mono text-[0.85em]">TESTIMONIALS</code> trong{" "}
                  <code class="rounded bg-amber-200/70 px-1.5 py-0.5 font-mono text-[0.85em]">src/data/courses.ts</code>.
                  Điền đủ 3 mục là phần này tự chuyển sang bản hoàn chỉnh.
                </p>
              </div>
            </div>

            <ul class="grid md:grid-cols-3 gap-5 mt-8 list-none">
              {[1, 2, 3].map((slot) => (
                <li class="rounded-card border-2 border-dashed border-amber-300 bg-white/70 p-5 flex flex-col justify-between min-h-[190px]">
                  <div>
                    <Quote className="w-6 h-6 text-amber-300" aria-hidden="true" />
                    <p class="mt-3 text-sm font-semibold text-amber-900 italic">
                      Chỗ dành cho nhận xét thật của phụ huynh #{slot}
                    </p>
                  </div>
                  <div class="mt-4 pt-3 border-t border-dashed border-amber-300 text-xs text-amber-900 space-y-1">
                    <div>Tên phụ huynh: <span class="font-bold">TODO</span></div>
                    <div>Cơ sở: <span class="font-bold">TODO</span></div>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        ) : (
          <ul class="grid md:grid-cols-3 gap-5 list-none">
            {TESTIMONIALS.map((item) => (
              <li class="bg-white rounded-card border border-slate-200 shadow-soft p-6 flex flex-col justify-between">
                <div>
                  <Quote className="w-6 h-6 text-amber-500" aria-hidden="true" />
                  <blockquote class="mt-3 text-sm text-slate-700 leading-relaxed">{item.quote}</blockquote>
                </div>
                <footer class="mt-5 pt-4 border-t border-slate-200">
                  <div class="font-bold text-slate-900 text-sm">{item.author}</div>
                  <div class="text-xs text-slate-600 mt-0.5">{item.role} • {item.branch}</div>
                </footer>
              </li>
            ))}
          </ul>
        )}
      </div>
    </section>

    <!--
      Câu hỏi thường gặp. Cố tình không dùng accordion: nội dung trả lời luôn hiện,
      phụ huynh không phải bấm mở từng câu mới đọc được.
    -->
    <section id="faq" class="py-16 bg-white border-t border-slate-200">
      <div class="max-w-6xl mx-auto px-4">
        <div class="max-w-2xl">
          <span class="gc-eyebrow">Giải đáp trước khi đăng ký</span>
          <h2 class="gc-section-title text-3xl md:text-4xl lg:text-5xl font-extrabold mt-3">Câu Hỏi Thường Gặp</h2>
        </div>

        <dl class="grid md:grid-cols-2 gap-x-10 gap-y-7 mt-10">
          {FAQS.map((item) => (
            <div class="border-t border-slate-200 pt-4">
              <dt class="font-bold text-slate-900 text-base flex items-start gap-2">
                <HelpCircle className="w-4 h-4 text-amber-600 shrink-0 mt-1" aria-hidden="true" />
                <span>{item.q}</span>
              </dt>
              <dd class="text-sm text-slate-600 mt-2 leading-relaxed pl-6">{item.a}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <!-- Pricing & Dynamic VietQR Checkout -->
    <PricingAndCheckout client:load />
    </main>

    <SiteFooter />

    <MobileContactBar />

    <script is:inline>
      // Progressive enhancement: clicking a branch card opens the checkout modal
      // with that branch already selected. Without JS the anchor still jumps to #pricing.
      document.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        const trigger = target.closest(".js-choose-branch");
        if (!(trigger instanceof HTMLElement)) return;
        const branchId = trigger.dataset.branch;
        if (!branchId) return;
        window.dispatchEvent(
          new CustomEvent("gc:choose-branch", {
            detail: { branchId, trigger: trigger },
          })
        );
      });
    </script>
</Layout>