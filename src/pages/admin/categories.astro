---
// src/pages/admin/categories.astro
// Mục của bài đăng (thanh lọc ở /news, menu Tin tức): thêm, đổi tên, đổi thứ tự, xoá. Chỉ Quản trị.
// Mỗi mục là một form riêng; sau khi lưu chuyển hướng về trang này (tránh gửi lại form khi tải lại).
export const prerender = false;

import AdminLayout from "../../layouts/AdminLayout.astro";
import {
  CategoryError,
  createCategory,
  deleteCategory,
  listCategoriesWithCounts,
  moveCategory,
  renameCategory,
} from "../../server/categories";
import { getDb } from "../../server/db";
import { CATEGORIES_POLICY } from "../../server/policy";

const me = Astro.locals.user!;
if (me.role !== "admin") return new Response("Chỉ quản trị được sửa các mục.", { status: 403 });
const db = getDb();
const actor = { id: me.id, username: me.username };

const DONE: Record<string, string> = {
  added: "Đã thêm mục. Mục hiện ở trang Tin tức khi có bài đã đăng.",
  saved: "Đã đổi tên mục.",
  moved: "Đã đổi thứ tự.",
  deleted: "Đã xoá mục.",
};

let error = "";

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const intent = String(form.get("intent") ?? "");
  const id = Number(form.get("id") ?? 0);
  const name = String(form.get("name") ?? "");
  const go = (ok: string) => Astro.redirect(`/admin/categories?ok=${ok}`);
  try {
    if (intent === "add") {
      createCategory(db, name, actor);
      return go("added");
    }
    if (intent === "save") {
      renameCategory(db, id, name, actor);
      return go("saved");
    }
    if (intent === "up" || intent === "down") {
      moveCategory(db, id, intent === "up" ? -1 : 1, actor);
      return go("moved");
    }
    if (intent === "delete") {
      deleteCategory(db, id, actor);
      return go("deleted");
    }
  } catch (caught) {
    if (!(caught instanceof CategoryError)) throw caught;
    error = caught.message;
    Astro.response.status = 400;
  }
}

const done = DONE[Astro.url.searchParams.get("ok") ?? ""] ?? "";
const categories = listCategoriesWithCounts(db);
const field = "border-2 border-slate-300 bg-white p-3 text-base focus:border-brand-600 focus:outline-none w-full";
const btn = "min-h-11 px-4 font-bold border-2";
---

<AdminLayout title="Mục bài đăng" active="categories" user={me}>
  <h1 class="text-2xl lg:text-3xl font-extrabold">Mục bài đăng</h1>
  <p class="mt-1 max-w-prose text-slate-600">
    Các mục hiện thành tab lọc ở trang Tin tức và trong menu, theo thứ tự dưới đây. Mục chưa có bài đã đăng thì tạm ẩn ở trang công khai.
    Đổi tên không làm hỏng liên kết cũ. Chỉ xoá được mục không còn bài nào, kể cả bài nháp.
  </p>

  {done && <p role="status" class="mt-5 border-l-4 border-green-700 bg-white px-4 py-3 font-semibold text-green-800">{done}</p>}
  {error && <p role="alert" class="mt-5 border-l-4 border-seal-red bg-white px-4 py-3 font-semibold text-seal-red">{error}</p>}

  <ul class="mt-8 grid gap-4">
    {categories.map((category, index) => (
      <li class="bg-white border-2 border-slate-200 p-5">
        <form method="post" class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-end">
          <input type="hidden" name="id" value={category.id} />
          <label class="flex flex-col gap-1.5">
            <span class="font-semibold">Tên mục</span>
            <input name="name" value={category.name} required maxlength={CATEGORIES_POLICY.nameMax} class={field} />
            <span class="text-sm text-slate-600">
              {category.published} bài đã đăng{category.total > category.published && `, ${category.total - category.published} nháp`} · địa chỉ <code>/news?category={category.slug}</code>
            </span>
          </label>
          <div class="flex flex-wrap gap-3">
            <button type="submit" name="intent" value="save" class={`${btn} border-brand-800 bg-brand-800 text-white hover:bg-brand-700`}>Lưu tên</button>
            <button type="submit" name="intent" value="up" formnovalidate disabled={index === 0} class={`${btn} border-slate-400 bg-white disabled:opacity-40`} aria-label={`Đưa mục ${category.name} lên trước`}>↑ Lên</button>
            <button type="submit" name="intent" value="down" formnovalidate disabled={index === categories.length - 1} class={`${btn} border-slate-400 bg-white disabled:opacity-40`} aria-label={`Đưa mục ${category.name} xuống sau`}>↓ Xuống</button>
            <button
              type="submit"
              name="intent"
              value="delete"
              formnovalidate
              disabled={category.total > 0 || categories.length <= 1}
              title={category.total > 0 ? "Còn bài trong mục này; chuyển bài sang mục khác trước." : undefined}
              class={`${btn} border-seal-red bg-white text-seal-red hover:bg-red-50 disabled:opacity-40 disabled:hover:bg-white`}
            >Xoá</button>
          </div>
        </form>
      </li>
    ))}
  </ul>

  <section class="mt-10 bg-white border-2 border-slate-200 p-5">
    <h2 class="text-lg font-bold">Thêm mục</h2>
    {categories.length >= CATEGORIES_POLICY.maxCategories ? (
      <p class="mt-2 text-slate-600">Đã đủ {CATEGORIES_POLICY.maxCategories} mục. Hãy xoá bớt một mục không dùng để thêm mới.</p>
    ) : (
      <form method="post" class="mt-3 flex max-w-xl flex-wrap items-end gap-3">
        <input type="hidden" name="intent" value="add" />
        <label class="flex min-w-60 flex-1 flex-col gap-1.5">
          <span class="font-semibold">Tên mục mới</span>
          <input name="name" required maxlength={CATEGORIES_POLICY.nameMax} class={field} />
        </label>
        <button type="submit" class={`${btn} border-brand-800 bg-brand-800 text-white hover:bg-brand-700`}>Thêm mục</button>
      </form>
    )}
  </section>
</AdminLayout>
