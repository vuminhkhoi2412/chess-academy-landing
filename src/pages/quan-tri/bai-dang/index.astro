---
// src/pages/quan-tri/bai-dang/index.astro
// Danh sách bài đăng cho mọi nhân viên: nháp và đã đăng, bấm vào để sửa.
export const prerender = false;

import AdminLayout from "../../../layouts/AdminLayout.astro";
import { getDb } from "../../../server/db";
import { listImages, listPosts } from "../../../server/posts";
import { formatTime } from "../../../server/session";

const me = Astro.locals.user!;
const db = getDb();
const posts = listPosts(db);
const DONE: Record<string, string> = { deleted: "Đã xoá bài viết." };
const done = DONE[Astro.url.searchParams.get("ok") ?? ""] ?? "";
---

<AdminLayout title="Bài đăng" active="bai-dang" user={me}>
  <div class="flex flex-wrap items-center justify-between gap-4">
    <h1 class="text-2xl lg:text-3xl font-extrabold">Bài đăng</h1>
    <a href="/quan-tri/bai-dang/moi" class="inline-flex min-h-12 items-center px-6 bg-brand-800 text-white font-bold hover:bg-brand-700">Viết bài mới</a>
  </div>

  {done && <p role="status" class="mt-5 border-l-4 border-green-700 bg-white px-4 py-3 font-semibold text-green-800">{done}</p>}

  <div class="mt-6 overflow-x-auto bg-white border-2 border-slate-200">
    <table class="w-full text-left">
      <thead class="bg-slate-100">
        <tr>
          <th class="px-4 py-3">Tiêu đề</th>
          <th class="px-4 py-3">Trạng thái</th>
          <th class="px-4 py-3">Sửa lần cuối</th>
          <th class="px-4 py-3"><span class="sr-only">Mở</span></th>
        </tr>
      </thead>
      <tbody>
        {posts.length === 0 && (
          <tr><td colspan="4" class="px-4 py-6 text-slate-600">Chưa có bài nào. Bấm "Viết bài mới" để bắt đầu.</td></tr>
        )}
        {posts.map((post) => (
          <tr class="border-t border-slate-200">
            <td class="px-4 py-3 font-semibold">{post.title}</td>
            <td class="px-4 py-3">
              {post.status === "published"
                ? <span class="font-bold text-green-800">Đã đăng</span>
                : <span class="font-bold text-slate-600">Nháp</span>}
              {listImages(db, post.id).length > 0 && <span class="ml-2 text-sm text-slate-500">có ảnh</span>}
            </td>
            <td class="px-4 py-3 whitespace-nowrap tabular-nums text-slate-600">{formatTime(post.updatedAt)} · {post.updatedBy ?? "?"}</td>
            <td class="px-4 py-3"><a href={`/quan-tri/bai-dang/${post.id}`} class="inline-flex min-h-11 items-center px-4 border-2 border-brand-800 font-bold text-brand-800 hover:bg-brand-50">Mở</a></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</AdminLayout>
