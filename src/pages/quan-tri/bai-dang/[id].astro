---
// src/pages/quan-tri/bai-dang/[id].astro
// Soạn và sửa một bài (id = "moi" để viết bài mới). Một form duy nhất: mọi nút bấm đều lưu chữ trước,
// nên thêm ảnh hay đăng bài không làm mất phần vừa gõ.
export const prerender = false;

import AdminLayout from "../../../layouts/AdminLayout.astro";
import { getDb } from "../../../server/db";
import { POSTS_POLICY } from "../../../server/policy";
import {
  PostError,
  addImage,
  createPost,
  deletePost,
  getPostById,
  listImages,
  removeImage,
  setCover,
  setPublished,
  updatePost,
} from "../../../server/posts";
import { formatTime } from "../../../server/session";
import { UploadError, deleteImages, saveImage } from "../../../server/uploads";

const me = Astro.locals.user!;
const db = getDb();
const actor = { id: me.id, username: me.username };

const isNew = Astro.params.id === "moi";
const id = isNew ? 0 : Number(Astro.params.id);
let post = isNew ? null : Number.isInteger(id) ? getPostById(db, id) : null;
if (!isNew && !post) return Astro.redirect("/quan-tri/bai-dang");

const DONE: Record<string, string> = {
  saved: "Đã lưu nháp.",
  published: "Đã đăng. Bài đã hiện ở trang Tin tức.",
  unpublished: "Đã gỡ về nháp. Bài không còn hiện công khai.",
  image: "Đã thêm ảnh.",
  removed: "Đã gỡ ảnh.",
  cover: "Đã đổi ảnh bìa.",
};

let error = "";
let confirmingDelete = false;
let draft = { title: post?.title ?? "", summary: post?.summary ?? "", body: post?.body ?? "" };
let consentChecked = false;

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const intent = String(form.get("intent") ?? "save");
  draft = {
    title: String(form.get("title") ?? ""),
    summary: String(form.get("summary") ?? ""),
    body: String(form.get("body") ?? ""),
  };
  consentChecked = form.get("photo_consent") === "1";
  const go = (ok: string) => Astro.redirect(`/quan-tri/bai-dang/${post!.id}?ok=${ok}`);
  try {
    if (intent === "delete" || intent === "delete_confirmed") {
      if (!post) throw new PostError("not_found", "Bài viết chưa được lưu.");
      if (me.role !== "admin") throw new PostError("forbidden", "Chỉ quản trị mới được xoá bài.");
      if (intent === "delete") {
        confirmingDelete = true;
      } else {
        await deleteImages(deletePost(db, post.id, actor));
        return Astro.redirect("/quan-tri/bai-dang?ok=deleted");
      }
    } else {
      // Mọi nút khác đều lưu chữ trước.
      post = post ? updatePost(db, post.id, draft, actor) : createPost(db, draft, actor);

      if (intent === "publish") {
        setPublished(db, post.id, true, actor, Date.now(), consentChecked);
        return go("published");
      }
      if (intent === "unpublish") {
        setPublished(db, post.id, false, actor);
        return go("unpublished");
      }
      if (intent === "upload") {
        const files = form.getAll("photos").filter((f): f is File => f instanceof File && f.size > 0);
        if (files.length === 0) throw new PostError("no_file", "Hãy chọn ít nhất một ảnh.");
        const room = POSTS_POLICY.maxImages - listImages(db, post.id).length;
        if (files.length > room) throw new PostError("too_many_images", `Chỉ thêm được ${room} ảnh nữa (tối đa ${POSTS_POLICY.maxImages} ảnh mỗi bài).`);
        const saved: string[] = [];
        try {
          for (const file of files) saved.push(await saveImage(new Uint8Array(await file.arrayBuffer())));
          saved.forEach((name) => addImage(db, post!.id, name, "", actor));
        } catch (caught) {
          await deleteImages(saved);
          throw caught;
        }
        return go("image");
      }
      if (intent.startsWith("remove:")) {
        const file = removeImage(db, post.id, Number(intent.slice(7)), actor);
        if (file) await deleteImages([file]);
        return go("removed");
      }
      if (intent.startsWith("cover:")) {
        setCover(db, post.id, Number(intent.slice(6)), actor);
        return go("cover");
      }
      return go("saved");
    }
  } catch (caught) {
    if (caught instanceof PostError || caught instanceof UploadError) {
      error = caught.message;
      Astro.response.status = 400;
    } else throw caught;
  }
}

const done = DONE[Astro.url.searchParams.get("ok") ?? ""] ?? "";
const images = post ? listImages(db, post.id) : [];
const published = post?.status === "published";
const field = "border-2 border-slate-300 bg-white p-3 text-base focus:border-brand-600 focus:outline-none w-full";
const btn = "min-h-12 px-5 font-bold border-2";
---

<AdminLayout title={isNew ? "Viết bài mới" : "Sửa bài"} active="bai-dang" user={me}>
  <a href="/quan-tri/bai-dang" class="font-semibold text-brand-800 underline">← Tất cả bài đăng</a>
  <div class="mt-2 flex flex-wrap items-center gap-3">
    <h1 class="text-2xl lg:text-3xl font-extrabold">{isNew ? "Viết bài mới" : "Sửa bài"}</h1>
    {post && (published
      ? <span class="px-3 py-1 bg-green-800 text-white font-bold">Đã đăng</span>
      : <span class="px-3 py-1 bg-slate-600 text-white font-bold">Nháp</span>)}
  </div>
  {post && <p class="mt-1 text-sm text-slate-600">Sửa lần cuối: {post.updatedBy ?? "?"}, {formatTime(post.updatedAt)}</p>}

  {done && <p role="status" class="mt-5 border-l-4 border-green-700 bg-white px-4 py-3 font-semibold text-green-800">{done}</p>}
  {error && <p role="alert" class="mt-5 border-l-4 border-seal-red bg-white px-4 py-3 font-semibold text-seal-red">{error}</p>}

  {confirmingDelete && post && (
    <section role="alertdialog" aria-labelledby="del-title" class="mt-6 border-2 border-seal-red bg-white p-6">
      <h2 id="del-title" class="text-lg font-extrabold">Xoá hẳn bài "{post.title}"?</h2>
      <p class="mt-2">Bài và toàn bộ ảnh của bài sẽ mất, không khôi phục được. Muốn chỉ ẩn bài thì chọn "Gỡ về nháp".</p>
      <form method="post" class="mt-5 flex flex-wrap gap-3">
        <button type="submit" name="intent" value="delete_confirmed" class={`${btn} border-seal-red bg-seal-red text-white`}>Có, xoá hẳn</button>
        <a href={`/quan-tri/bai-dang/${post.id}`} class={`${btn} inline-flex items-center border-slate-400 bg-white`}>Không, giữ lại</a>
      </form>
    </section>
  )}

  <form method="post" enctype="multipart/form-data" class="mt-8 grid gap-8 lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)]">
    <div class="grid content-start gap-6">
      <label class="flex flex-col gap-1.5">
        <span class="font-semibold">Tiêu đề</span>
        <input name="title" value={draft.title} required maxlength={POSTS_POLICY.titleMax} class={field} />
      </label>
      <label class="flex flex-col gap-1.5">
        <span class="font-semibold">Tóm tắt ngắn (hiện ở danh sách tin)</span>
        <textarea name="summary" rows="2" maxlength={POSTS_POLICY.summaryMax} class={field}>{draft.summary}</textarea>
        <span class="text-sm text-slate-600">Tối đa {POSTS_POLICY.summaryMax} ký tự. Có thể để trống.</span>
      </label>
      <div class="flex flex-col gap-1.5">
        <label for="body" class="font-semibold">Nội dung</label>
        <div class="flex flex-wrap items-center gap-3">
          <button type="button" id="add-heading" class="min-h-11 px-4 border-2 border-slate-400 bg-white font-bold hover:bg-slate-50">+ Thêm tiêu đề mục</button>
          <span class="text-sm text-slate-600">Cách nhau một dòng trống là sang đoạn mới.</span>
        </div>
        <textarea id="body" name="body" rows="18" maxlength={POSTS_POLICY.bodyMax} class={field}>{draft.body}</textarea>
      </div>
    </div>

    <div class="grid content-start gap-6">
      <section class="bg-white border-2 border-slate-200 p-5">
        <h2 class="text-lg font-bold">Ảnh</h2>
        <p class="mt-1 text-sm text-slate-600">Ảnh đầu tiên là ảnh bìa. Tối đa {POSTS_POLICY.maxImages} ảnh, mỗi ảnh nhỏ hơn {POSTS_POLICY.maxUploadBytes / 1024 / 1024} MB. Hệ thống tự thu nhỏ ảnh và xoá thông tin vị trí chụp.</p>
        {images.length > 0 && (
          <ul class="mt-4 grid gap-4 sm:grid-cols-2">
            {images.map((image, index) => (
              <li class="border-2 border-slate-200">
                <img src={`/uploads/${image.file}`} alt="" class="aspect-[4/3] w-full object-cover" loading="lazy" />
                <div class="p-2 grid gap-2">
                  {index === 0
                    ? <p class="font-bold text-green-800">Ảnh bìa</p>
                    : <button type="submit" name="intent" value={`cover:${image.id}`} class="min-h-11 border-2 border-slate-400 bg-white font-bold hover:bg-slate-50">Làm ảnh bìa</button>}
                  <button type="submit" name="intent" value={`remove:${image.id}`} class="min-h-11 border-2 border-seal-red bg-white font-bold text-seal-red hover:bg-red-50">Gỡ ảnh</button>
                </div>
              </li>
            ))}
          </ul>
        )}
        <div class="mt-4 grid gap-3">
          <input type="file" name="photos" accept="image/*" multiple class="block w-full text-base file:mr-4 file:min-h-11 file:border-2 file:border-slate-400 file:bg-white file:px-4 file:font-bold" />
          <button type="submit" name="intent" value="upload" class={`${btn} border-brand-800 bg-white text-brand-800 hover:bg-brand-50`}>Thêm ảnh đã chọn</button>
        </div>
      </section>

      <section class="bg-white border-2 border-slate-200 p-5">
        <h2 class="text-lg font-bold">Đăng bài</h2>
        {(images.length > 0 && !published) && (
          <label class="mt-3 flex cursor-pointer items-start gap-3 border-2 border-slate-300 p-3 has-[:checked]:border-brand-800 has-[:checked]:bg-brand-50">
            <input type="checkbox" name="photo_consent" value="1" checked={consentChecked} class="mt-1 size-5 shrink-0" />
            <span><strong>Tôi xác nhận đã được phụ huynh đồng ý cho đăng ảnh các bé trong bài này.</strong></span>
          </label>
        )}
        <div class="mt-4 grid gap-3">
          <button type="submit" name="intent" value="save" class={`${btn} border-brand-800 bg-white text-brand-800 hover:bg-brand-50`}>Lưu nháp</button>
          {published
            ? <button type="submit" name="intent" value="unpublish" class={`${btn} border-slate-700 bg-slate-700 text-white`}>Gỡ về nháp</button>
            : <button type="submit" name="intent" value="publish" class={`${btn} border-green-800 bg-green-800 text-white hover:bg-green-700`}>Đăng bài</button>}
          {published && post && <a href={`/tin-tuc/${post.slug}`} target="_blank" rel="noopener" class={`${btn} inline-flex items-center justify-center border-slate-400 bg-white`}>Xem bài trên trang</a>}
          {published && <p class="text-sm text-slate-600">Bấm "Lưu nháp" để lưu chỉnh sửa; bài đã đăng cập nhật ngay.</p>}
        </div>
      </section>

      {post && me.role === "admin" && (
        <section class="bg-white border-2 border-slate-200 p-5">
          <h2 class="text-lg font-bold">Xoá bài</h2>
          <button type="submit" name="intent" value="delete" class={`mt-3 ${btn} border-seal-red bg-white text-seal-red hover:bg-red-50`}>Xoá bài này…</button>
        </section>
      )}
    </div>
  </form>

  <script>
    const body = document.getElementById("body") as HTMLTextAreaElement | null;
    document.getElementById("add-heading")?.addEventListener("click", () => {
      if (!body) return;
      const at = body.selectionStart ?? body.value.length;
      const before = body.value.slice(0, at).replace(/\s+$/, "");
      const after = body.value.slice(at).replace(/^\s+/, "");
      const lead = before === "" ? "" : "\n\n";
      body.value = `${before}${lead}## ${after === "" ? "" : "\n\n" + after}`.replace(/## $/, "## ");
      const caret = before.length + lead.length + 3;
      body.focus();
      body.setSelectionRange(caret, caret);
    });
  </script>
</AdminLayout>
