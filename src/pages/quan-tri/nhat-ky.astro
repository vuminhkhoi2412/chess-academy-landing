---
// src/pages/quan-tri/nhat-ky.astro
// Chỉ quản trị: 200 thay đổi gần nhất, ai làm gì lúc nào.
export const prerender = false;

import AdminLayout from "../../layouts/AdminLayout.astro";
import { listAudit } from "../../server/auth";
import { getDb } from "../../server/db";
import { formatTime } from "../../server/session";

const me = Astro.locals.user!;
if (me.role !== "admin") return Astro.redirect("/quan-tri");

const LABELS: Record<string, string> = {
  login: "Đăng nhập",
  login_failed: "Đăng nhập sai",
  logout: "Đăng xuất",
  user_created: "Tạo tài khoản",
  password_reset: "Đặt lại mật khẩu",
  user_deactivated: "Khoá tài khoản",
  user_activated: "Mở khoá tài khoản",
  role_changed: "Đổi quyền",
};
const ROLE_NAME: Record<string, string> = { admin: "Quản trị", editor: "Biên tập" };

// Chi tiết lấy từ DB được dựng lại thành câu tiếng Việt, không in nguyên JSON ra màn hình.
function describe(action: string, detail: Record<string, unknown> | null): string {
  if (!detail) return "";
  if (action === "role_changed") return `${ROLE_NAME[String(detail.from)] ?? "?"} → ${ROLE_NAME[String(detail.to)] ?? "?"}`;
  if (action === "user_created") return `Quyền: ${ROLE_NAME[String(detail.role)] ?? "?"}`;
  if (action === "login" || action === "login_failed") return `IP ${String(detail.ip ?? "?")}`;
  return "";
}

const rows = listAudit(getDb(), 200);
---

<AdminLayout title="Nhật ký thay đổi" active="nhat-ky" user={me}>
  <h1 class="text-2xl lg:text-3xl font-extrabold">Nhật ký thay đổi</h1>
  <p class="mt-1 text-slate-600">200 sự kiện gần nhất, mới nhất ở trên.</p>

  <div class="mt-6 overflow-x-auto bg-white border-2 border-slate-200">
    <table class="w-full text-left">
      <thead class="bg-slate-100">
        <tr>
          <th class="px-4 py-3">Lúc</th>
          <th class="px-4 py-3">Người thực hiện</th>
          <th class="px-4 py-3">Việc đã làm</th>
          <th class="px-4 py-3">Đối tượng</th>
          <th class="px-4 py-3">Chi tiết</th>
        </tr>
      </thead>
      <tbody>
        {rows.length === 0 && (
          <tr><td colspan="5" class="px-4 py-6 text-slate-600">Chưa có sự kiện nào.</td></tr>
        )}
        {rows.map((row) => (
          <tr class="border-t border-slate-200">
            <td class="px-4 py-3 whitespace-nowrap tabular-nums">{formatTime(row.at)}</td>
            <td class="px-4 py-3">{row.username ?? "—"}</td>
            <td class:list={["px-4 py-3 font-semibold", row.action === "login_failed" && "text-seal-red"]}>{LABELS[row.action] ?? row.action}</td>
            <td class="px-4 py-3">{row.target ?? "—"}</td>
            <td class="px-4 py-3 text-slate-600">{describe(row.action, row.detail)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</AdminLayout>
