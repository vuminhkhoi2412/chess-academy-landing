---
// src/pages/quan-tri/dang-nhap.astro
export const prerender = false;

import Layout from "../../layouts/Layout.astro";
import { login } from "../../server/auth";
import { getDb } from "../../server/db";
import { AUTH_POLICY } from "../../server/policy";
import { SESSION_COOKIE, clientIp } from "../../server/session";

// Middleware đã gán người dùng: ai đã đăng nhập thì vào thẳng tổng quan.
if (Astro.locals.user) return Astro.redirect("/quan-tri");

let error = "";
let username = "";

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  username = String(form.get("username") ?? "");
  const password = String(form.get("password") ?? "");

  let socketAddress: string | undefined;
  try {
    socketAddress = Astro.clientAddress;
  } catch {
    socketAddress = undefined;
  }

  const result = login(getDb(), { username, password, ip: clientIp(Astro.request.headers, socketAddress) });
  if (result.ok) {
    Astro.cookies.set(SESSION_COOKIE, result.token, {
      httpOnly: true,
      sameSite: "lax",
      secure: import.meta.env.PROD,
      path: "/quan-tri",
      expires: new Date(result.expiresAt),
    });
    return Astro.redirect("/quan-tri");
  }
  error =
    result.reason === "locked"
      ? `Đăng nhập sai quá nhiều lần. Vui lòng thử lại sau ${AUTH_POLICY.lockoutMinutes} phút.`
      : "Tên đăng nhập hoặc mật khẩu không đúng.";
}
---

<Layout
  title="Đăng nhập – Quản trị Global Chess"
  description="Đăng nhập trang quản trị nội bộ của Global Chess."
  robots="noindex, nofollow"
  canonical={false}
  social={false}
  bodyClass="min-h-dvh"
>
  <div class="min-h-dvh grid md:grid-cols-[1fr_1fr]">
    <section class="bg-brand-800 text-white p-8 md:p-14 flex flex-col justify-end">
      <p class="font-display text-4xl md:text-6xl font-extrabold">GLOBAL CHESS</p>
      <p class="mt-2 text-lg text-brand-200">Trang quản trị nội bộ</p>
    </section>

    <main id="main" tabindex="-1" class="bg-cream p-8 md:p-14 flex flex-col justify-center">
      <h1 class="text-2xl md:text-3xl font-extrabold text-slate-900">Đăng nhập</h1>

      {error && (
        <p role="alert" class="mt-5 border-l-4 border-seal-red bg-white px-4 py-3 font-semibold text-seal-red">
          {error}
        </p>
      )}

      <form method="post" class="mt-6 flex flex-col gap-5 md:max-w-xl">
        <label class="flex flex-col gap-1.5">
          <span class="font-semibold">Tên đăng nhập</span>
          <input
            name="username"
            value={username}
            autocomplete="username"
            autocapitalize="none"
            spellcheck="false"
            required
            class="min-h-12 border-2 border-slate-300 bg-white px-3 text-base focus:border-brand-600 focus:outline-none"
          />
        </label>
        <label class="flex flex-col gap-1.5">
          <span class="font-semibold">Mật khẩu</span>
          <input
            name="password"
            type="password"
            autocomplete="current-password"
            required
            class="min-h-12 border-2 border-slate-300 bg-white px-3 text-base focus:border-brand-600 focus:outline-none"
          />
        </label>
        <button type="submit" class="min-h-12 bg-brand-800 text-white font-bold text-base hover:bg-brand-700">
          Đăng nhập
        </button>
      </form>

      <p class="mt-6 text-sm text-slate-600 md:max-w-xl">
        Quên mật khẩu? Nhờ quản trị viên đặt lại cho bạn.
      </p>
    </main>
  </div>
</Layout>
