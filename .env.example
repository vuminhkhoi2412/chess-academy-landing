# Copy file này thành `.env` rồi điền giá trị thật.
# Trên Vercel: Project Settings -> Environment Variables, hoặc `vercel env add`.
#
# PUBLIC_GOOGLE_SHEETS_ENDPOINT là URL kết thúc bằng /exec của Google Apps Script
# (xem docs/google-sheets-setup.md). Không có giá trị mặc định, thiếu là
# `npm run build` báo lỗi.

PUBLIC_GOOGLE_SHEETS_ENDPOINT=https://script.google.com/macros/s/REPLACE_ME/exec
