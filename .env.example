# Copy file này thành `.env` rồi điền giá trị thật.
# Trên Vercel: Project Settings -> Environment Variables, hoặc `vercel env add`.
#
# PUBLIC_ACB_ACCOUNT_NO và PUBLIC_ACB_ACCOUNT_NAME không có giá trị mặc định,
# thiếu là `npm run build` báo lỗi.

PUBLIC_ACB_BANK_ID=ACB
PUBLIC_ACB_ACCOUNT_NO=0000000000
PUBLIC_ACB_ACCOUNT_NAME=TEN CHU TAI KHOAN
PUBLIC_ACB_TEMPLATE=compact2
